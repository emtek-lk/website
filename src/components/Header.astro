---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logoLight from '../logos/Emtek_Logo-transparent-cropped.png';
import { nav, site } from '../data/site';
import { services } from '../data/services';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="absolute inset-x-0 top-0 z-50">
  <nav class="container-page flex h-20 items-center justify-between" aria-label="Main">
    <a href="/" class="shrink-0 rounded-md" aria-label={`${site.name} home`}>
      <Image src={logoLight} alt={site.name} width={112} densities={[1, 2]} loading="eager" fetchpriority="high" class="h-auto w-[112px]" />
    </a>

    <!-- Desktop -->
    <ul class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) =>
          item.href === '/services' ? (
            <li class="group relative">
              <a
                href={item.href}
                class:list={[
                  'inline-flex items-center gap-1 rounded-full px-4 py-2 text-[15px] font-medium text-white/90 transition hover:text-white',
                  isActive(item.href) && 'text-white',
                ]}
                aria-haspopup="true"
              >
                {item.label}
                <Icon name="chevronDown" class="size-4 transition group-hover:rotate-180 group-focus-within:rotate-180" />
              </a>
              <div class="invisible absolute top-full left-1/2 w-[26rem] -translate-x-1/2 translate-y-1 pt-3 opacity-0 transition duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                <ul class="rounded-2xl border border-line bg-white p-2 shadow-[0_30px_60px_-20px_rgba(10,31,61,0.35)]">
                  {services.map((s) => (
                    <li>
                      <a href={`/services/${s.slug}`} class="flex gap-4 rounded-xl p-3 transition hover:bg-canvas">
                        <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-700">
                          <Icon name={s.icon} />
                        </span>
                        <span>
                          <span class="block text-[15px] font-semibold text-ink">{s.shortTitle}</span>
                          <span class="mt-0.5 line-clamp-2 block text-sm text-muted">{s.summary}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class:list={[
                  'rounded-full px-4 py-2 text-[15px] font-medium text-white/90 transition hover:text-white',
                  isActive(item.href) && 'text-white',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
    </ul>

    <a href="/contact" class="btn btn-light hidden md:inline-flex">
      Talk to us <Icon name="arrowRight" class="arrow size-4" />
    </a>

    <!-- Mobile: <details> gives a working menu with zero JavaScript -->
    <details class="group md:hidden">
      <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-full text-white [&::-webkit-details-marker]:hidden" aria-label="Menu">
        <Icon name="menu" class="size-6 group-open:hidden" />
        <Icon name="close" class="hidden size-6 group-open:block" />
      </summary>
      <div class="absolute inset-x-4 top-18 rounded-2xl border border-line bg-white p-3 shadow-[0_30px_60px_-20px_rgba(10,31,61,0.45)]">
        <p class="px-3 pt-2 pb-1 text-xs font-semibold tracking-wide text-muted uppercase">Services</p>
        <ul>
          {
            services.map((s) => (
              <li>
                <a href={`/services/${s.slug}`} class="flex items-center gap-3 rounded-xl px-3 py-2.5 font-medium text-ink hover:bg-canvas">
                  <span class="text-brand-700"><Icon name={s.icon} /></span>
                  {s.shortTitle}
                </a>
              </li>
            ))
          }
        </ul>
        <hr class="my-2 border-line" />
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="block rounded-xl px-3 py-2.5 font-medium text-ink hover:bg-canvas">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/contact" class="btn btn-primary mt-2 w-full justify-center">Talk to us</a>
      </div>
    </details>
  </nav>
</header>
