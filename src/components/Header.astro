---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import TechLogo from './TechLogo.astro';
import ModuleIcon from './erp/ModuleIcon.astro';
import logoLight from '../logos/Emtek_Logo-transparent-cropped.png';
import { nav, site } from '../data/site';
import { services } from '../data/services';
import { erpPlatforms, otherErps } from '../data/erp';

const path = Astro.url.pathname.replace(/\.html$/, '');
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const megaMenus = new Set(['/services', '/erp']);
const erpTagline: Record<string, string> = {
  'cortex-erp': 'Our own ERP platform',
  'microsoft-dynamics-365': 'Microsoft business apps',
  odoo: 'Open, modular ERP',
};
const linkClass = (href: string) => [
  'nav-link inline-flex items-center gap-1 rounded-full px-4 py-2 text-[15px] font-medium text-white/90 hover:text-white',
  isActive(href) && 'text-white',
];
---

<header class="site-header fixed inset-x-0 top-0 z-50">
  <nav class="site-nav container-page flex h-20 items-center justify-between" aria-label="Main">
    <a href="/" class="shrink-0 rounded-md" aria-label={`${site.name} home`}>
      <Image src={logoLight} alt={site.name} width={112} densities={[1, 2]} loading="eager" fetchpriority="high" class="h-auto w-[112px]" />
    </a>

    <!-- Desktop: each <li> fills the nav height so the pointer never leaves it on the way to a mega menu -->
    <ul class="hidden items-stretch self-stretch md:flex">
      {
        nav.map((item) =>
          megaMenus.has(item.href) ? (
            <li class="group flex items-center">
              <a href={item.href} class:list={linkClass(item.href)} aria-expanded="false" aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
                <Icon name="chevronDown" class="size-4 transition-transform duration-500 ease-flow group-hover:rotate-180 group-focus-within:rotate-180" />
                
              </a>

              <!-- Mega menu: spans the page container, directly under the bar -->
              <div class="mega-menu absolute inset-x-0 top-full pt-1">
                <div class="container-page">
                  <div class="neu-surface overflow-hidden rounded-3xl">
                    {item.href === '/services' ? (
                      <div class="grid lg:grid-cols-12">
                        <div class="grid gap-x-2 p-4 lg:col-span-9 lg:grid-cols-3">
                          {services.map((s, i) => (
                            <div class="mega-col rounded-2xl p-4 hover:bg-canvas" style={`--i:${i}`}>
                              <a href={`/services/${s.slug}`} class="group/col flex items-center gap-3">
                                <span class="icon-tile size-11 transition group-hover/col:bg-brand-700 group-hover/col:text-white">
                                  <Icon name={s.icon} class="size-5" />
                                </span>
                                <span class="text-[15px] leading-snug font-semibold text-ink group-hover/col:text-brand-700">{s.shortTitle}</span>
                              </a>
                              <ul class="mt-4 space-y-0.5 border-t border-line pt-3">
                                {s.offerings.map((o) => (
                                  <li>
                                    <a href={`/services/${s.slug}#${o.id}`} class="flex items-start gap-2 rounded-lg px-2 py-1.5 text-sm leading-snug text-body transition hover:bg-white hover:text-brand-700">
                                      <Icon name="arrowRight" class="mt-0.5 size-3.5 shrink-0 text-brand-400" />
                                      {o.title}
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          ))}
                        </div>
                        <div class="mega-col hero-gradient relative flex flex-col justify-between p-7 lg:col-span-3" style="--i:3">
                          <div>
                            <p class="text-sm font-semibold text-brand-200">Not sure where to start?</p>
                            <p class="mt-2 text-xl leading-snug font-semibold text-white">Tell us what’s slowing your business down.</p>
                            <p class="mt-3 text-sm leading-relaxed text-white/75">We’ll help you plan the right mix of ERP, software, and IT support.</p>
                          </div>
                          <div class="mt-6 space-y-3">
                            <a href="/contact" class="btn btn-light w-full justify-center">Talk to us <Icon name="arrowRight" class="arrow size-4" /></a>
                            <a href={site.phoneHref} class="flex items-center justify-center gap-2 text-sm font-medium text-white/85 hover:text-white">
                              <Icon name="phone" class="size-4" /> {site.phone}
                            </a>
                          </div>
                        </div>
                      </div>
                    ) : (
                      <div class="grid lg:grid-cols-12">
                        <div class="grid gap-x-2 p-4 lg:col-span-9 lg:grid-cols-3">
                          {erpPlatforms.map((p, i) => (
                            <a href={`/erp/${p.slug}`} class="mega-col group/col rounded-2xl p-4 hover:bg-canvas" style={`--accent:${p.theme.accent};--i:${i}`}>
                              <span class="flex items-center gap-3">
                                <span class="well size-12 transition group-hover/col:bg-white">
                                  <TechLogo name={p.logo} class={p.slug === 'odoo' ? 'h-4 w-9' : 'size-7'} />
                                </span>
                                <span class="leading-snug">
                                  <span class="block text-[15px] font-semibold text-ink group-hover/col:text-[var(--accent)]">{p.name}</span>
                                  <span class="block text-xs text-muted">{erpTagline[p.slug]}</span>
                                </span>
                              </span>
                              <span class="mt-4 block border-t border-line pt-4 text-sm leading-relaxed text-body">{p.intro.title}.</span>
                              <span class="mt-4 flex items-center gap-1.5">
                                {p.modules
                                  .filter((m) => m.glyph !== 'plus')
                                  .slice(0, 6)
                                  .map((m) => (
                                    <span title={m.name}>
                                      <ModuleIcon module={m} class="size-7" />
                                    </span>
                                  ))}
                              </span>
                              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--accent)]">
                                Explore <Icon name="arrowRight" class="size-4 transition group-hover/col:translate-x-1" />
                              </span>
                            </a>
                          ))}
                        </div>
                        <div class="mega-col flex flex-col justify-between bg-canvas p-7 lg:col-span-3" style="--i:3">
                          <div>
                            <p class="text-sm font-semibold text-ink">Also implemented by EMTEK</p>
                            <ul class="mt-4 space-y-2">
                              {otherErps.map((name) => (
                                <li class="chip w-full">
                                  <TechLogo name={name} class="size-5" />
                                  {name}
                                </li>
                              ))}
                            </ul>
                          </div>
                          <a href="/erp" class="btn btn-primary mt-6 w-full justify-center">
                            Compare ERP platforms <Icon name="arrowRight" class="arrow size-4" />
                          </a>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </li>
          ) : (
            <li class="flex items-center">
              <a href={item.href} class:list={linkClass(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
                
              </a>
            </li>
          ),
        )
      }
    </ul>

    <a href="/contact" class="btn btn-light hidden md:inline-flex">
      Talk to us <Icon name="arrowRight" class="arrow size-4" />
    </a>

    <!-- Mobile: <details> gives a working menu with zero JavaScript -->
    <details class="mobile-menu group md:hidden">
      <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-full text-white [&::-webkit-details-marker]:hidden" aria-label="Menu">
        <Icon name="menu" class="size-6 group-open:hidden" />
        <Icon name="close" class="hidden size-6 group-open:block" />
      </summary>
      <div class="neu-surface absolute inset-x-4 top-18 max-h-[calc(100vh-6rem)] overflow-y-auto rounded-2xl p-3">
        <p class="px-3 pt-2 pb-1 text-xs font-semibold tracking-wide text-muted uppercase">Services</p>
        <ul>
          {
            services.map((s) => (
              <li>
                <a href={`/services/${s.slug}`} class="flex items-center gap-3 rounded-xl px-3 py-2.5 font-medium text-ink hover:bg-canvas">
                  <span class="text-brand-700">
                    <Icon name={s.icon} />
                  </span>
                  {s.shortTitle}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="px-3 pt-3 pb-1 text-xs font-semibold tracking-wide text-muted uppercase">ERP platforms</p>
        <ul>
          {
            erpPlatforms.map((p) => (
              <li>
                <a href={`/erp/${p.slug}`} class="flex items-center gap-3 rounded-xl px-3 py-2.5 font-medium text-ink hover:bg-canvas">
                  <span class="grid w-9 place-items-center">
                    <TechLogo name={p.logo} class={p.slug === 'odoo' ? 'h-3.5 w-9' : 'size-5'} />
                  </span>
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
        <hr class="my-2 border-line" />
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="block rounded-xl px-3 py-2.5 font-medium text-ink hover:bg-canvas">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/contact" class="btn btn-primary mt-2 w-full justify-center">Talk to us</a>
      </div>
    </details>
  </nav>
</header>
