---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Flag from './Flag.astro';
import Icon from './Icon.astro';
import { getService } from '../data/services';
import { countryNames } from '../data/testimonials';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Heading level for the title, so cards nest correctly under their section heading */
  headingLevel?: 'h2' | 'h3';
}

const { project: p, headingLevel = 'h3' } = Astro.props;
const { data } = p;
const Heading = headingLevel;
const country = data.country ? (countryNames[data.country as keyof typeof countryNames] ?? data.country.toUpperCase()) : undefined;
---

<a href={`/projects/${p.id}`} class="card group flex flex-col overflow-hidden !p-0 hover:-translate-y-1">
  {
    data.cover ? (
      <Image src={data.cover} alt={data.coverAlt ?? ''} width={720} class="aspect-[16/9] w-full object-cover" />
    ) : data.clientLogo ? (
      <div class="relative flex h-40 items-center justify-center bg-gradient-to-br from-white to-brand-50 px-8">
        <Image src={data.clientLogo} alt={`${data.client} logo`} width={240} class="h-20 w-auto max-w-[65%] object-contain transition duration-300 group-hover:scale-105" />
        {country && (
          <span class="absolute top-4 right-4 inline-flex items-center gap-2 rounded-full bg-white py-1 pr-3 pl-1 text-xs font-semibold text-ink shadow-sm ring-1 ring-line">
            <Flag code={data.country!} class="size-5" />
            {country}
          </span>
        )}
      </div>
    ) : (
      <div class="hero-gradient h-40 w-full" />
    )
  }
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <p class="text-sm text-muted">{[data.client, data.industry, data.year].filter(Boolean).join(' · ')}</p>
    <Heading class="mt-2 text-lg leading-snug font-semibold text-ink group-hover:text-brand-700">{data.title}</Heading>
    <p class="mt-3 flex-1 text-[15px] leading-relaxed">{data.summary}</p>
    <div class="mt-5 flex flex-wrap gap-1.5">
      {data.services.map((slug) => <span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-700">{getService(slug)?.shortTitle}</span>)}
    </div>
    <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700">
      Read the case study <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" />
    </span>
  </div>
</a>
