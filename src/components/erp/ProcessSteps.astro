---
import Icon from '../Icon.astro';
import { erpProcess } from '../../data/erp';

interface Props {
  title?: string;
  lead?: string;
}

const {
  title = 'How we deliver your ERP',
  lead = 'A proven path from first conversation to a system your team relies on every day.',
} = Astro.props;
---

<section class="container-page py-20 sm:py-28">
  <div class="max-w-2xl">
    <p class="eyebrow !text-[var(--accent,#2463b8)]">Our process</p>
    <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{title}</h2>
    <p class="mt-4 text-lg">{lead}</p>
  </div>

  <ol class="relative mt-14 grid gap-8 md:grid-cols-5 md:gap-5">
    <span class="absolute top-7 right-[10%] left-[10%] hidden h-0.5 bg-gradient-to-r from-[var(--accent-soft,#e0f2fa)] via-[var(--accent,#2463b8)] to-[var(--accent-soft,#e0f2fa)] opacity-60 md:block" aria-hidden="true"></span>
    {
      erpProcess.map((step, i) => (
        <li class="relative flex gap-5 md:flex-col md:items-center md:text-center" data-reveal>
          <span class="relative grid size-14 shrink-0 place-items-center rounded-2xl bg-white text-[var(--accent,#2463b8)] shadow-[0_14px_30px_-14px_rgba(10,31,61,0.45)] ring-1 ring-line">
            <Icon name={step.icon} class="size-6" />
            <span class="absolute -top-2 -right-2 grid size-6 place-items-center rounded-full bg-[var(--accent,#2463b8)] text-[11px] font-bold text-white">{i + 1}</span>
          </span>
          <div>
            <h3 class="font-semibold md:mt-5">{step.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed">{step.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
