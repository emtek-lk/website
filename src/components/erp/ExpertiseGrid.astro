---
import Icon from '../Icon.astro';
import { erpExpertise } from '../../data/erp';

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
}

const {
  eyebrow = 'Why EMTEK',
  title = 'ERP specialists, from source code to support desk',
  lead = 'Most ERP partners either configure software or run infrastructure. We do both, and we build our own ERP too.',
} = Astro.props;
---

<section class="relative isolate overflow-hidden bg-ink">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="dot-grid absolute inset-0 opacity-50"></div>
    <div class="blob absolute -top-40 left-[20%] size-[30rem] rounded-full bg-brand-500/25 blur-[110px]"></div>
  </div>
  <div class="container-page py-14 sm:py-28">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-wide text-brand-300">{eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">{title}</h2>
      <p class="mt-4 text-lg text-brand-100/75">{lead}</p>
    </div>
    <ul class="snap-lg mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        erpExpertise.map((e) => (
          <li class="group rounded-2xl bg-white/[0.04] p-6 ring-1 ring-white/10 transition duration-300 hover:bg-white/[0.07] hover:ring-white/20" data-reveal>
            <span class="grid size-11 place-items-center rounded-xl bg-gradient-to-br from-white/15 to-white/5 text-brand-200 ring-1 ring-white/15 transition group-hover:from-brand-400 group-hover:to-brand-600 group-hover:text-white">
              <Icon name={e.icon} class="size-5" />
            </span>
            <h3 class="mt-5 font-semibold text-white">{e.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-brand-100/70">{e.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
