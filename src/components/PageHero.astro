---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="hero-gradient hero-slant relative overflow-hidden pt-36 pb-28 sm:pt-44 sm:pb-36">
  <div class="container-page relative">
    <div class="max-w-3xl">
      {eyebrow && <p class="text-sm font-semibold tracking-wide text-brand-200">{eyebrow}</p>}
      <h1 class="mt-3 text-4xl font-semibold text-white sm:text-5xl">{title}</h1>
      {lead && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-brand-100/90 sm:text-xl">{lead}</p>}
      <slot />
    </div>
  </div>
</section>
