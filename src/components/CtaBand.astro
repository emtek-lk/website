---
import Icon from './Icon.astro';
import TechLogo from './TechLogo.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { erpPlatforms } from '../data/erp';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Let’s turn your complexity into clarity',
  text = 'Tell us what’s slowing your business down. We’ll help you plan the right mix of ERP, software, and IT support, and stay with you long after launch.',
} = Astro.props;

// Orbit nodes come from our own platform and service data, so they stay current as those lists change.
// Slots are offsets (px) from the centre of the rings.
const slots = [
  [0, -104],
  [150, -55],
  [48, 28],
  [-90, 52],
  [-155, -40],
  [100, 110],
];
const nodes = [
  ...erpPlatforms.map((p) => ({ logo: p.logo, wide: p.slug === 'odoo' })),
  ...services.map((s) => ({ icon: s.icon })),
].slice(0, slots.length);
---

<!-- The card hangs over the top of the footer; the footer adds matching top padding when this band is on the page -->
<section class="cta-band container-page relative z-10 -mb-16 pt-10 sm:-mb-24 sm:pt-28">
  <div class="hero-gradient relative overflow-hidden rounded-3xl px-6 py-14 shadow-2xl shadow-ink/30 sm:px-14 sm:py-16">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-14">
      <!-- Orbit of our platforms and services -->
      <div class="relative order-last hidden h-64 lg:order-first lg:block" aria-hidden="true">
        {
          [7, 13, 20].map((rem) => (
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-dashed border-white/25" style={`width:${rem}rem;height:${rem}rem`} />
          ))
        }
        <div class="absolute top-1/2 left-1/2 grid size-12 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white/15 text-white ring-1 ring-white/40 ring-inset">
          <Icon name="layers" class="size-5" />
        </div>
        {
          nodes.map((n, i) => (
            <span
              class="absolute grid size-10 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white shadow-lg shadow-ink/30"
              style={`left:calc(50% + ${slots[i][0]}px);top:calc(50% + ${slots[i][1]}px)`}
            >
              {n.logo ? <TechLogo name={n.logo} class={n.wide ? 'h-3 w-6' : 'size-5'} /> : <Icon name={n.icon!} class="size-5 text-brand-700" />}
            </span>
          ))
        }
      </div>

      <div>
        <h2 class="text-3xl font-semibold text-white sm:text-4xl" data-words>{title}</h2>
        <p class="mt-4 max-w-xl text-lg text-brand-100/90">{text}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`mailto:${site.email}`} class="btn btn-light">
            <Icon name="mail" class="size-4" /> {site.email}
          </a>
          <a href={site.phoneHref} class="btn btn-outline-light">
            <Icon name="phone" class="size-4" /> {site.phone}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
