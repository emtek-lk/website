---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Let’s turn your complexity into clarity',
  text = 'Tell us what’s slowing your business down. We’ll help you plan the right mix of ERP, software, and IT support, and stay with you long after launch.',
} = Astro.props;
---

<section class="container-page py-20 sm:py-28">
  <div class="hero-gradient relative overflow-hidden rounded-3xl px-6 py-14 sm:px-14 sm:py-16">
    <div class="grid items-center gap-10 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <h2 class="text-3xl font-semibold text-white sm:text-4xl">{title}</h2>
        <p class="mt-4 max-w-xl text-lg text-brand-100/90">{text}</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-2 lg:justify-end">
        <a href={`mailto:${site.email}`} class="btn btn-light">
          <Icon name="mail" class="size-4" /> {site.email}
        </a>
        <a href={site.phoneHref} class="btn border border-white/30 text-white hover:bg-white/10">
          <Icon name="phone" class="size-4" /> {site.phone}
        </a>
      </div>
    </div>
  </div>
</section>
