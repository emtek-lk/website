---
import Icon from './Icon.astro';
import BrandCoin from './BrandCoin.astro';
import TechLogo from './TechLogo.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { erpPlatforms } from '../data/erp';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Let’s turn your complexity into clarity',
  text = 'Tell us what’s slowing your business down. We’ll help you plan the right mix of ERP, software, and IT support, and stay with you long after launch.',
} = Astro.props;

// Orbit nodes come from our own platform and service data (interleaved so logos and icons alternate), so they stay
// current as those lists change. They are dealt onto rings of 1, 2 and 3 nodes; each ring drifts at its own speed.
const pool = [] as { logo?: string; wide?: boolean; icon?: any }[];
for (let i = 0; i < Math.max(erpPlatforms.length, services.length); i++) {
  if (erpPlatforms[i]) pool.push({ logo: erpPlatforms[i].logo, wide: erpPlatforms[i].slug === 'odoo' });
  if (services[i]) pool.push({ icon: services[i].icon });
}
const rings = [
  { size: 8, count: 1, dur: 40, offset: 40 },
  { size: 12, count: 2, dur: 60, offset: 200 },
  { size: 16, count: 3, dur: 90, offset: 90 },
].map((r, ri, all) => {
  const before = all.slice(0, ri).reduce((n, x) => n + x.count, 0);
  return {
    ...r,
    nodes: pool.slice(before, before + r.count).map((n, i) => {
      const deg = r.offset + (360 / r.count) * i;
      const rad = (deg * Math.PI) / 180;
      return { ...n, x: 50 + 50 * Math.cos(rad), y: 50 + 50 * Math.sin(rad) };
    }),
  };
});
---

<!-- The card hangs over the top of the footer; the footer adds matching top padding when this band is on the page -->
<section class="cta-band container-page relative z-10 -mb-16 pt-10 sm:-mb-24 sm:pt-28">
  <div class="hero-gradient relative overflow-hidden rounded-3xl px-6 py-14 shadow-2xl shadow-ink/30 sm:px-14 sm:py-16">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-14">
      <!-- Orbit of our platforms and services around the brand coin -->
      <div class="relative order-last hidden h-60 lg:order-first lg:block" aria-hidden="true">
        {
          rings.map((r, ri) => (
            <div
              class="cta-orbit-ring absolute rounded-full border border-dashed border-white/25"
              style={`--dur:${r.dur}s;left:50%;top:50%;width:${r.size}rem;height:${r.size}rem;margin:-${r.size / 2}rem 0 0 -${r.size / 2}rem;${ri === 1 ? 'animation-direction:reverse' : ''}`}
            >
              {r.nodes.map((n) => (
                <span class="absolute" style={`left:${n.x}%;top:${n.y}%;width:2.5rem;height:2.5rem;margin:-1.25rem 0 0 -1.25rem`}>
                  <span
                    class="cta-orbit-node grid size-full place-items-center rounded-full shadow-lg shadow-ink/30"
                    style={`background:#fff;--dur:${r.dur}s;${ri === 1 ? 'animation-direction:normal' : ''}`}
                  >
                    {n.logo ? <TechLogo name={n.logo} class={n.wide ? 'h-3 w-6' : 'size-5'} /> : <Icon name={n.icon} class="size-5 text-brand-700" />}
                  </span>
                </span>
              ))}
            </div>
          ))
        }
        <div class="absolute inset-0 grid place-items-center"><BrandCoin size="4rem" /></div>
      </div>

      <div>
        <h2 class="text-3xl font-semibold text-white sm:text-4xl" data-words>{title}</h2>
        <p class="mt-4 max-w-xl text-lg text-brand-100/90">{text}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`mailto:${site.email}`} class="btn btn-light">
            <Icon name="mail" class="size-4" /> {site.email}
          </a>
          <a href={site.phoneHref} class="btn btn-outline-light">
            <Icon name="phone" class="size-4" /> {site.phone}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
