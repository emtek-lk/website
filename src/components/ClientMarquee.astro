---
import { Image } from 'astro:assets';
import { clients } from '../data/clients';
import { logoSize } from '../data/logo-size';

// Each (margin-trimmed) logo is sized by its aspect ratio so wide and square marks carry equal visual weight
const fill = (i: number) => {
  const rest = clients.length % 3; // tiles in the last (short) row of the 3-across phone grid
  if (rest === 1 && i === clients.length - 1) return 'full';
  if (rest === 2 && i >= clients.length - 2 && i < clients.length) return 'half';
  return undefined;
};
const items = clients.map((c) => ({ ...c, size: logoSize(c.logo, { area: 14000, maxWidth: 190, maxHeight: 92 }) }));
---

<!-- Infinite logo marquee: the list is rendered twice and the track slides by exactly half its width.
     It pauses while hovered or while a logo has keyboard focus. -->
<section class="pt-10 pb-6 sm:pt-14" aria-labelledby="clients-heading">
  <p id="clients-heading" class="container-page text-center text-lg font-semibold text-ink sm:text-xl">Trusted by businesses in Sri Lanka and around the world</p>
  <div class="container-page"><div class="marquee mt-10 overflow-hidden py-3">
    <ul class="marquee-track flex w-max items-center gap-5">
      {
        [...items, ...items].map((c, i) => (
          <li data-fill={fill(i)} class="tile grid h-20 w-36 shrink-0 place-items-center px-3 sm:h-32 sm:w-60 sm:px-6" aria-hidden={i >= items.length ? 'true' : undefined}>
            <Image src={c.logo} loading="lazy" decoding="async" alt={i < items.length ? `${c.name} logo` : ''} width={c.size.width * 2} widths={[c.size.width, c.size.width * 2]} sizes={`(max-width: 639px) ${Math.round(c.size.width * 0.5)}px, ${c.size.width}px`} style={`--w:${c.size.width}px;--h:${c.size.height}px`} class="logo-img" />
          </li>
        ))
      }
    </ul>
  </div>
  </div>
</section>
