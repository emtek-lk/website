---
import flags from '@iconify-json/circle-flags/icons.json';
import { nextLogoId } from '../data/tech';

interface Props {
  /** ISO 3166-1 alpha-2 code, lower case */
  code: string;
  class?: string;
}

const { code, class: className = 'size-5' } = Astro.props;
const set = flags as unknown as { icons: Record<string, { body: string }> };
const icon = set.icons[code];
if (!icon) throw new Error(`Unknown flag "${code}"`);

const uid = nextLogoId();
const body = icon.body
  .replace(/\bid="([^"]+)"/g, `id="$1-${uid}"`)
  .replace(/url\(#([^)]+)\)/g, `url(#$1-${uid})`)
  .replace(/href="#([^"]+)"/g, `href="#$1-${uid}"`);
---

<svg viewBox="0 0 512 512" class:list={[className, 'shrink-0 rounded-full shadow-[0_0_0_1px_rgba(10,31,61,0.12)]']} aria-hidden="true" set:html={body} />
