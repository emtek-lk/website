---
import Icon, { type IconName } from '../Icon.astro';
import TechLogo from '../TechLogo.astro';
import ModuleIcon from '../erp/ModuleIcon.astro';
import { getErpPlatform } from '../../data/erp';

const d365Modules = getErpPlatform('microsoft-dynamics-365')!.modules.slice(0, 6);

const capabilities: { icon: IconName; title: string; text: string }[] = [
  { icon: 'code', title: 'Source-level customization', text: 'We modify the software itself, so it behaves the way your business does.' },
  { icon: 'layers', title: 'Custom functional modules', text: 'New capabilities built on top of Dynamics 365, not bolted on beside it.' },
  { icon: 'plug', title: 'API hooks into your tools', text: 'Your existing systems stay connected, with no re-keying of data.' },
  { icon: 'database', title: 'Legacy data migration', text: 'ETL pipelines move your history across into secure, ACID-compliant databases.' },
];
const builtWith = ['C#', '.NET', 'Microsoft SQL Server', 'Microsoft Azure'];
---

<section id="dynamics-365" class="relative isolate overflow-hidden bg-gradient-to-b from-white via-[#eaf3fd] to-white">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-24 left-[-8%] size-[30rem] rounded-full bg-[#cfe3fb] blur-[100px]"></div>
    <div class="absolute right-[-6%] bottom-0 size-[26rem] rounded-full bg-[#e3e0fb] blur-[100px]"></div>
  </div>

  <div class="container-page grid items-center gap-12 py-16 sm:py-32 lg:grid-cols-2 lg:gap-16">
    <!-- Layer cascade (decorative): hover to fan the layers apart -->
    <div class="layer-stack order-2 mx-auto w-full max-w-[26rem] lg:order-1" aria-hidden="true" data-reveal>
      <div class="layer-card layer-1">
        <div class="float-a flex h-full items-start gap-4 rounded-2xl bg-gradient-to-br from-white to-[#dbe9fc] p-5 shadow-float ring-1 ring-brand-200">
          <TechLogo name="Microsoft Dynamics 365" class="size-14 shrink-0" />
          <div>
            <p class="flex items-center gap-2 text-[0.65rem] font-semibold tracking-widest text-brand-600 uppercase"><span class="grid size-5 place-items-center rounded-full bg-brand-600 text-[0.65rem] text-white">1</span>The platform</p>
            <p class="mt-1.5 text-lg font-semibold text-ink">Microsoft Dynamics 365</p>
            <div class="mt-2.5 flex gap-1.5">{d365Modules.map((m) => <span title={m.name}><ModuleIcon module={m} class="size-6" /></span>)}</div>
          </div>
        </div>
      </div>

      <div class="layer-card layer-2">
        <div class="float-a h-full rounded-2xl bg-gradient-to-br from-[#6f9cff] to-[#5a5ce8] p-5 text-white shadow-float ring-1 ring-white/40 [animation-delay:-2.3s]">
          <p class="flex items-center gap-2 text-[0.65rem] font-semibold tracking-widest text-white/85 uppercase"><span class="grid size-5 place-items-center rounded-full bg-white text-[0.65rem] text-[#5a5ce8]">2</span>EMTEK layer</p>
          <p class="mt-1.5 text-lg font-semibold">Custom modules &amp; API hooks</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <span class="rounded-md bg-white/20 px-2 py-1 text-[0.7rem] font-semibold">C#</span>
            <span class="rounded-md bg-white/20 px-2 py-1 text-[0.7rem] font-semibold">.NET</span>
            <span class="rounded-md bg-white/20 px-2 py-1 text-[0.7rem] font-semibold">ETL pipelines</span>
          </div>
        </div>
      </div>

      <div class="layer-card layer-3">
        <div class="float-a h-full rounded-2xl bg-white p-5 shadow-float ring-1 ring-brand-100 [animation-delay:-4.6s]">
          <p class="flex items-center gap-2 text-[0.65rem] font-semibold tracking-widest text-emerald-600 uppercase"><span class="grid size-5 place-items-center rounded-full bg-emerald-500 text-[0.65rem] text-white">3</span>The result</p>
          <p class="mt-1.5 text-lg font-semibold text-ink">Your workflows, unchanged</p>
          <ul class="mt-2.5 grid grid-cols-2 gap-x-3 gap-y-1.5 text-xs text-body">
            <li class="flex items-center gap-1.5"><Icon name="check" class="size-3.5 text-emerald-500" strokeWidth={3} />Your approvals</li>
            <li class="flex items-center gap-1.5"><Icon name="check" class="size-3.5 text-emerald-500" strokeWidth={3} />Your reports</li>
            <li class="flex items-center gap-1.5"><Icon name="check" class="size-3.5 text-emerald-500" strokeWidth={3} />Your rules</li>
            <li class="flex items-center gap-1.5"><Icon name="check" class="size-3.5 text-emerald-500" strokeWidth={3} />Your data</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="order-1 lg:order-2">
      <div class="inline-flex items-center gap-3 rounded-full bg-white py-1.5 pr-4 pl-1.5 shadow-sm ring-1 ring-brand-100">
        <TechLogo name="Microsoft Dynamics 365" class="size-8" />
        <span class="text-sm font-semibold tracking-wide text-brand-700">Microsoft Dynamics 365</span>
      </div>
      <h2 class="mt-6 text-4xl font-semibold sm:text-5xl">
        Dynamics 365, <span class="bg-gradient-to-r from-brand-700 via-[#3f5fe0] to-[#7a5af0] bg-clip-text text-transparent">adapted to your workflows</span>
      </h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed">
        Keep the platform you trust and the processes your team already knows. We customize Dynamics 365 around the way you work, so you never have to change established workflows to fit generic software.
      </p>

      <ul class="snap-lg mt-10 grid gap-4 sm:grid-cols-2">
        {
          capabilities.map((c) => (
            <li class="tile tile-lift group p-5">
              <span class="icon-tile size-10 transition group-hover:bg-brand-700 group-hover:text-white">
                <Icon name={c.icon} class="size-5" />
              </span>
              <h3 class="mt-4 font-semibold text-ink">{c.title}</h3>
              <p class="mt-1 text-sm leading-relaxed">{c.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap items-center gap-2">
        <span class="mr-1 text-sm text-muted">Built with</span>
        {builtWith.map((t) => <span class="chip"><TechLogo name={t} class="size-5" />{t.replace('Microsoft ', '')}</span>)}
      </div>

      <a href="/erp/microsoft-dynamics-365" class="btn btn-primary mt-10">
        Explore Dynamics 365 <Icon name="arrowRight" class="arrow size-4" />
      </a>
    </div>
  </div>
</section>
