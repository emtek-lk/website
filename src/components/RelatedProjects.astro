---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import Icon from './Icon.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  title?: string;
  eyebrow?: string;
  class?: string;
}

const { projects, title = 'Recent work', eyebrow = 'Case studies', class: className = '' } = Astro.props;
---

{
  projects.length > 0 && (
    <section class:list={['container-page py-20 sm:py-28', className]}>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow !text-[var(--accent,#2463b8)]">{eyebrow}</p>
          <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{title}</h2>
        </div>
        <a href="/projects" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-900">
          All projects <Icon name="arrowRight" class="size-4" />
        </a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>
  )
}
