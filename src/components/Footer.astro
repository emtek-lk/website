---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import TechLogo from './TechLogo.astro';
import logoLight from '../logos/Emtek_Logo-transparent-cropped.png';
import { site, mapsUrl } from '../data/site';
import { services } from '../data/services';
import { erpPlatforms } from '../data/erp';

const year = new Date().getFullYear();
const company = [
  { label: 'About us', href: '/about' },
  { label: 'Our team', href: '/about#team' },
  { label: 'Projects', href: '/projects' },
  { label: 'Contact', href: '/contact' },
];
const linkClass = 'inline-block py-0.5 transition hover:text-white hover:translate-x-0.5';
const headingClass = 'text-xs font-semibold tracking-widest text-white uppercase';
---

<footer class="relative isolate overflow-hidden bg-ink text-brand-100/70">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="dot-grid absolute inset-0 opacity-30"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-300/40 to-transparent"></div>
  </div>

  <div class="container-page pt-16 pb-10">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-8 sm:gap-y-12 lg:grid-cols-12">
      <!-- Brand -->
      <div class="col-span-2 lg:col-span-3">
        <a href="/" aria-label={`${site.name} home`} class="inline-block rounded-md">
          <Image src={logoLight} alt={site.name} width={120} densities={[1, 2]} class="h-auto w-[120px]" />
        </a>
        <p class="mt-5 text-lg font-semibold text-white">{site.tagline}</p>
        <p class="mt-3 max-w-sm text-sm leading-relaxed">{site.description}</p>
        <h2 class={`${headingClass} mt-8`}>Follow us</h2>
        <SocialLinks compact class="mt-4" />
      </div>

      <!-- Services -->
      <nav aria-label="Services" class="lg:col-span-2">
        <h2 class={headingClass}>Services</h2>
        <ul class="mt-5 space-y-2.5 text-sm">
          {
            services.map((s) => (
              <li>
                <a href={`/services/${s.slug}`} class={linkClass}>
                  {s.shortTitle}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/services" class="mt-1 inline-flex items-center gap-1.5 py-0.5 font-medium text-brand-300 transition hover:text-white">
              All services <Icon name="arrowRight" class="size-3.5" />
            </a>
          </li>
        </ul>
      </nav>

      <!-- ERP -->
      <nav aria-label="ERP platforms" class="lg:col-span-2">
        <h2 class={headingClass}>ERP platforms</h2>
        <ul class="mt-5 space-y-2.5 text-sm">
          {
            erpPlatforms.map((p) => (
              <li>
                <a href={`/erp/${p.slug}`} class={`${linkClass} inline-flex items-center gap-2`}>
                  <TechLogo name={p.logo} class={p.slug === 'odoo' ? 'h-3 w-7' : 'size-4'} />
                  {p.shortName}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/erp" class="mt-1 inline-flex items-center gap-1.5 py-0.5 font-medium text-brand-300 transition hover:text-white">
              All ERP platforms <Icon name="arrowRight" class="size-3.5" />
            </a>
          </li>
        </ul>
      </nav>

      <!-- Company -->
      <nav aria-label="Company" class="lg:col-span-2">
        <h2 class={headingClass}>Company</h2>
        <ul class="mt-5 space-y-2.5 text-sm">
          {
            company.map((c) => (
              <li>
                <a href={c.href} class={linkClass}>
                  {c.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contact -->
      <div class="col-span-2 lg:col-span-3">
        <h2 class={headingClass}>Contact</h2>
        <ul class="mt-5 space-y-3.5 text-sm">
          <li>
            <a href={`mailto:${site.email}`} class="group flex items-start gap-2.5 transition hover:text-white">
              <span class="footer-icon mt-0.5 shrink-0 text-brand-200 transition group-hover:text-white"><Icon name="mail" class="size-3.5" /></span>
              <span class="break-all">{site.email}</span>
            </a>
          </li>
          <li>
            <a href={site.phoneHref} class="group flex items-start gap-2.5 whitespace-nowrap transition hover:text-white">
              <span class="footer-icon mt-0.5 shrink-0 text-brand-200 transition group-hover:text-white"><Icon name="phone" class="size-3.5" /></span>
              {site.phone}
            </a>
          </li>
          <li>
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-2.5 transition hover:text-white">
              <span class="footer-icon mt-0.5 shrink-0 text-brand-200 transition group-hover:text-white"><Icon name="pin" class="size-3.5" /></span>
              <address class="leading-relaxed not-italic">
                {site.address.street},<br />{site.address.city} {site.address.postalCode},<br />{site.address.country}
              </address>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-14 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p class="max-w-md sm:text-right">All product names, logos, and brands are property of their respective owners.</p>
    </div>
  </div>
</footer>
