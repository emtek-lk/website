---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import TechLogo from './TechLogo.astro';
import logoLight from '../logos/Emtek_Logo-transparent-cropped.png';
import { site, mapsUrl } from '../data/site';
import { services } from '../data/services';
import { erpPlatforms } from '../data/erp';

const year = new Date().getFullYear();
const company = [
  { label: 'About us', href: '/about' },
  { label: 'Our team', href: '/about#team' },
  { label: 'Projects', href: '/projects' },
  { label: 'Contact', href: '/contact' },
];
const legal = [
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms of Service', href: '/terms' },
  { label: 'Cookie Policy', href: '/cookies' },
];
// Headings share one height on desktop so every column starts on the same line
const headingClass = 'text-xs font-semibold tracking-widest text-white uppercase md:flex md:h-8 md:items-center';
const listClass = 'mt-3 space-y-0.5 text-[15px] md:mt-4';
const linkClass = 'inline-flex items-center gap-2.5 py-1.5 transition duration-300 hover:translate-x-0.5 hover:text-white';
const moreClass = 'inline-flex items-center gap-1.5 py-1.5 font-medium text-brand-300 transition duration-300 hover:text-white';
---

<footer class="relative isolate overflow-hidden bg-ink text-brand-100/75">
  <!-- Brand-blue atmosphere: the same sky and blue as the hero, kept soft so text stays readable -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(60%_90%_at_88%_0%,rgb(45_127_208/0.3),transparent_70%),radial-gradient(55%_80%_at_0%_100%,rgb(28_77_141/0.5),transparent_70%),linear-gradient(180deg,#0a1f3d_0%,#0c264a_100%)]"></div>
    <div class="dot-grid absolute inset-0 opacity-25"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-300/50 to-transparent"></div>
  </div>

  <div class="container-page pt-16 pb-8 sm:pt-24">
    <!-- Brand on the left, link columns on the right -->
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4 lg:grid-cols-[2fr_1.8fr_1.3fr_1.1fr_1.6fr]">
      <div class="col-span-2 sm:col-span-4 lg:col-span-1">
        <a href="/" aria-label={`${site.name} home`} class="inline-flex items-center rounded-md">
          <Image src={logoLight} alt={site.name} width={140} densities={[1, 2]} class="h-auto w-[140px]" />
        </a>
        <p class="mt-5 text-sm font-semibold tracking-wide text-white">{site.tagline}</p>
        <p class="mt-2 text-sm leading-relaxed">ERP, custom software and managed IT, from build to ongoing support.</p>
        <SocialLinks compact class="mt-6 [&_a]:bg-transparent [&_a]:ring-1 [&_a]:ring-white/30 [&_a]:ring-inset [&_a]:hover:ring-transparent" />
      </div>

      <div class="contents">
        <nav aria-label="Services" class="col-span-2 sm:col-span-1">
          <h2 class={headingClass}>Services</h2>
          <ul class={listClass}>
            {
              services.map((s) => (
                <li>
                  <a href={`/services/${s.slug}`} class={linkClass}>
                    {s.shortTitle}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/services" class={moreClass}>
                All services <Icon name="arrowRight" class="size-3.5" />
              </a>
            </li>
          </ul>
        </nav>

        <nav aria-label="ERP platforms">
          <h2 class={headingClass}>ERP platforms</h2>
          <ul class={listClass}>
            {
              erpPlatforms.map((p) => (
                <li>
                  <a href={`/erp/${p.slug}`} class={linkClass}>
                    <span class="grid w-6 shrink-0 place-items-center">
                      <TechLogo name={p.logo} class={p.slug === 'odoo' ? 'h-3.5 w-6' : 'size-5'} />
                    </span>
                    {p.shortName}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/erp" class={moreClass}>
                All platforms <Icon name="arrowRight" class="size-3.5" />
              </a>
            </li>
          </ul>
        </nav>

        <nav aria-label="Company">
          <h2 class={headingClass}>Company</h2>
          <ul class={listClass}>
            {
              company.map((c) => (
                <li>
                  <a href={c.href} class={linkClass}>
                    {c.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="col-span-2 sm:col-span-1">
          <h2 class={headingClass}>Contact</h2>
          <ul class={`${listClass} space-y-2.5`}>
            <li>
              <a href={`mailto:${site.email}`} class="group flex items-center gap-2.5 py-1 transition duration-300 hover:text-white">
                <Icon name="mail" class="size-4 shrink-0 text-brand-300" />
                <span class="break-all">{site.email}</span>
              </a>
            </li>
            <li>
              <a href={site.phoneHref} class="group flex items-center gap-2.5 py-1 whitespace-nowrap transition duration-300 hover:text-white">
                <Icon name="phone" class="size-4 shrink-0 text-brand-300" />
                {site.phone}
              </a>
            </li>
            <li>
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-2.5 py-1 transition duration-300 hover:text-white">
                <Icon name="pin" class="mt-1 size-4 shrink-0 text-brand-300" />
                <address class="leading-relaxed not-italic">
                  {site.address.street},<br />{site.address.city} {site.address.postalCode},<br />{site.address.country}
                </address>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom bar: copyright left, legal links right -->
    <div class="mt-14 flex flex-col items-center gap-3 border-t border-white/10 pt-6 text-sm md:flex-row md:justify-between">
      <div class="contents">
        <p>&copy; {year} {site.name}. All rights reserved.</p>
        <ul class="flex flex-wrap justify-center gap-x-5 gap-y-1 text-[13px]" aria-label="Legal">
          {
            legal.map((l) => (
              <li>
                <a href={l.href} class="inline-block py-1 transition duration-300 hover:text-white">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</footer>
