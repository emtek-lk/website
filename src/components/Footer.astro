---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import TechLogo from './TechLogo.astro';
import logoLight from '../logos/Emtek_Logo-transparent-cropped.png';
import { site, mapsUrl } from '../data/site';
import { services } from '../data/services';
import { erpPlatforms } from '../data/erp';

const year = new Date().getFullYear();
const company = [
  { label: 'About us', href: '/about' },
  { label: 'Our team', href: '/about#team' },
  { label: 'Projects', href: '/projects' },
  { label: 'Contact', href: '/contact' },
];
const legal = [
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms of Service', href: '/terms' },
  { label: 'Cookie Policy', href: '/cookies' },
];
// Headings share one height on desktop so every column starts on the same line
const headingClass = 'text-xs font-semibold tracking-widest text-white uppercase md:flex md:h-8 md:items-center';
const listClass = 'mt-3 space-y-0.5 text-[15px] md:mt-4';
const linkClass = 'inline-flex items-center gap-2.5 py-1.5 transition duration-300 hover:translate-x-0.5 hover:text-white xl:whitespace-nowrap';
const moreClass = 'inline-flex items-center gap-1.5 py-1.5 font-medium text-brand-300 transition duration-300 hover:text-white';
const ringIcon = 'grid size-9 shrink-0 place-items-center rounded-full text-brand-200 ring-1 ring-white/25 ring-inset transition duration-300 group-hover:bg-white/10 group-hover:text-white group-hover:ring-white/50';
---

<footer class="relative isolate overflow-hidden bg-ink text-brand-100/75">
  <!-- Brand-blue atmosphere: the same sky and blue as the hero, kept soft so text stays readable -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(60%_90%_at_88%_0%,rgb(45_127_208/0.3),transparent_70%),radial-gradient(55%_80%_at_0%_100%,rgb(28_77_141/0.5),transparent_70%),linear-gradient(180deg,#0a1f3d_0%,#0c264a_100%)]"></div>
    <div class="dot-grid absolute inset-0 opacity-25"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-300/50 to-transparent"></div>
  </div>

  <div class="container-page pt-16 pb-10 sm:pt-24">
    <!--
      Desktop (xl): [ Services, ERP ]  logo  [ Company, Contact ]. The two side groups share the leftover width equally,
      so the logo sits at the exact centre. Below xl the groups dissolve (display: contents) into one responsive grid
      with the logo block first.
    -->
    <div class="grid grid-cols-2 items-start gap-x-8 gap-y-8 sm:gap-y-12 md:grid-cols-3 xl:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] xl:gap-x-10">
      <!-- Left group -->
      <div class="contents xl:grid xl:grid-cols-[1fr_auto] xl:gap-x-8">
        <nav aria-label="Services" class="col-span-2 sm:col-span-1">
          <h2 class={headingClass}>Services</h2>
          <ul class={listClass}>
            {
              services.map((s) => (
                <li>
                  <a href={`/services/${s.slug}`} class={`${linkClass} xl:whitespace-nowrap`}>
                    {s.shortTitle}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/services" class={moreClass}>
                All services <Icon name="arrowRight" class="size-3.5" />
              </a>
            </li>
          </ul>
        </nav>

        <nav aria-label="ERP platforms" class="sm:col-span-1">
          <h2 class={headingClass}>ERP platforms</h2>
          <ul class={listClass}>
            {
              erpPlatforms.map((p) => (
                <li>
                  <a href={`/erp/${p.slug}`} class={linkClass}>
                    <span class="grid w-6 shrink-0 place-items-center">
                      <TechLogo name={p.logo} class={p.slug === 'odoo' ? 'h-3.5 w-6' : 'size-5'} />
                    </span>
                    {p.shortName}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/erp" class={moreClass}>
                All platforms <Icon name="arrowRight" class="size-3.5" />
              </a>
            </li>
          </ul>
        </nav>
      </div>

      <!-- Brand: logo and tagline (first on phones and small laptops, centre on desktop) -->
      <div class="col-span-2 flex flex-col items-start max-xl:order-first md:col-span-3 xl:col-span-1 xl:items-center xl:text-center">
        <a href="/" aria-label={`${site.name} home`} class="inline-flex h-8 items-center rounded-md">
          <Image src={logoLight} alt={site.name} width={150} densities={[1, 2]} class="h-auto w-[150px]" />
        </a>
        <p class="mt-4 text-sm font-semibold tracking-wide whitespace-nowrap text-white">{site.tagline}</p>
      </div>

      <!-- Right group -->
      <div class="contents xl:grid xl:grid-cols-[auto_1fr] xl:gap-x-14">
        <nav aria-label="Company" class="sm:col-span-1">
          <h2 class={headingClass}>Company</h2>
          <ul class={listClass}>
            {
              company.map((c) => (
                <li>
                  <a href={c.href} class={linkClass}>
                    {c.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <!-- Contact: outlined icon circles inside a frosted-glass card. The negative top margin keeps its heading on the same line as the other columns. -->
        <div class="glass-card col-span-2 mt-2 sm:col-span-1 sm:mt-0 md:-mt-[21px] md:-ml-[25px]">
          <h2 class={headingClass}>Contact</h2>
          <ul class="mt-3 space-y-3.5 text-[15px] md:mt-4">
            <li>
              <a href={`mailto:${site.email}`} class="group flex items-center gap-3 transition duration-300 hover:text-white">
                <span class={ringIcon}><Icon name="mail" class="size-4" /></span>
                <span class="break-all">{site.email}</span>
              </a>
            </li>
            <li>
              <a href={site.phoneHref} class="group flex items-center gap-3 whitespace-nowrap transition duration-300 hover:text-white">
                <span class={ringIcon}><Icon name="phone" class="size-4" /></span>
                {site.phone}
              </a>
            </li>
            <li>
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-3 transition duration-300 hover:text-white">
                <span class={ringIcon}><Icon name="pin" class="size-4" /></span>
                <address class="leading-relaxed not-italic xl:whitespace-nowrap">
                  {site.address.street},<br />{site.address.city} {site.address.postalCode},<br />{site.address.country}
                </address>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Social links: centred, just above the divider -->
    <div class="mt-14 flex justify-center sm:mt-16">
      <SocialLinks class="justify-center [&_a]:bg-transparent [&_a]:ring-1 [&_a]:ring-white/30 [&_a]:ring-inset [&_a]:hover:ring-transparent" />
    </div>

    <!-- Bottom bar: copyright left, legal links right -->
    <div class="mt-8 flex flex-col items-center gap-3 border-t border-white/10 pt-6 text-sm md:flex-row md:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-1 text-[13px]" aria-label="Legal">
        {
          legal.map((l) => (
            <li>
              <a href={l.href} class="inline-block py-1 transition duration-300 hover:text-white">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
