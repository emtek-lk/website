---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Flag from './Flag.astro';
import { clientStories, countryNames } from '../data/testimonials';

const initials = (name: string) =>
  name
    .split(' ')
    .filter(Boolean)
    .map((w) => w[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

<section class="relative isolate overflow-hidden bg-canvas">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-24 right-[-6%] size-[28rem] rounded-full bg-brand-100 blur-[100px]"></div>
  </div>

  <div class="container-page py-20 sm:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow">Client stories</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">What we’ve built with our clients</h2>
      <p class="mt-4 text-lg">From ERP rollouts to custom apps and managed cloud, for clients in Sri Lanka and around the world.</p>
    </div>

    <ul class="mt-14 grid gap-6 lg:grid-cols-3">
      {
        clientStories.map((s) => (
          <li class="card group flex flex-col !p-0 overflow-hidden hover:-translate-y-1">
            <!-- Logo panel with the client's country -->
            <div class="relative flex h-36 items-end justify-center bg-gradient-to-br from-white to-brand-50 px-8 pb-6">
              <Image src={s.client.logo} alt={`${s.company} logo`} width={220} class="h-16 w-auto max-w-[60%] object-contain transition duration-300 group-hover:scale-105" />
              <span class="absolute top-4 right-4 inline-flex items-center gap-2 rounded-full bg-white py-1 pr-3 pl-1 text-xs font-semibold text-ink shadow-sm ring-1 ring-line">
                <Flag code={s.country} class="size-5" />
                {countryNames[s.country]}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-6 sm:p-8">
              {s.quote ? (
                <blockquote class="relative text-[17px] leading-relaxed text-ink">
                  <span class="absolute -top-3 -left-1 text-5xl leading-none text-brand-200" aria-hidden="true">“</span>
                  <p class="relative pl-5">{s.quote}</p>
                </blockquote>
              ) : (
                <div>
                  <p class="text-sm font-semibold text-brand-700">What we delivered</p>
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {s.delivered.map((d) =>
                      d.href ? (
                        <li>
                          <a href={d.href} class="chip hover:border-brand-300 hover:text-brand-700">
                            <Icon name="check" class="size-3.5 text-emerald-500" strokeWidth={3} />
                            {d.label}
                          </a>
                        </li>
                      ) : (
                        <li class="chip">
                          <Icon name="check" class="size-3.5 text-emerald-500" strokeWidth={3} />
                          {d.label}
                        </li>
                      ),
                    )}
                  </ul>
                </div>
              )}

              <div class="mt-6 flex flex-1 items-end">
                <div class="flex w-full items-center gap-3 border-t border-line pt-5">
                  <span class="grid size-11 shrink-0 place-items-center rounded-full bg-gradient-to-br from-brand-400 to-brand-700 text-sm font-semibold text-white">{initials(s.person)}</span>
                  <span class="min-w-0 flex-1 leading-snug">
                    <span class="block font-semibold text-ink">{s.person}</span>
                    <span class="block truncate text-sm text-muted">{s.role}, {s.company}</span>
                  </span>
                </div>
              </div>

              <a href={`/projects/${s.project}`} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-900">
                Read the case study <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" />
              </a>
            </div>
          </li>
        ))
      }
    </ul>

  </div>
</section>
