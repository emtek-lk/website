---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'EMTEK - Web Solutions for Your Business' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-white text-gray-900">
    <nav class="bg-primary text-white shadow-md sticky top-0 z-50">
      <div class="container mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-bold">EMTEK</a>
        <ul class="flex gap-6">
          <li><a href="/" class="hover:text-accent transition">Home</a></li>
          <li><a href="/about" class="hover:text-accent transition">About</a></li>
          <li><a href="/services" class="hover:text-accent transition">Services</a></li>
          <li><a href="/projects" class="hover:text-accent transition">Projects</a></li>
          <li><a href="/contact" class="hover:text-accent transition">Contact</a></li>
        </ul>
      </div>
    </nav>

    <main class="min-h-screen">
      <slot />
    </main>

    <footer class="bg-primary text-white mt-20">
      <div class="container mx-auto px-4 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div>
            <h3 class="text-lg font-bold mb-4">EMTEK</h3>
            <p class="text-gray-300">Web solutions for your business</p>
          </div>
          <div>
            <h4 class="font-bold mb-4">Quick Links</h4>
            <ul class="text-gray-300 space-y-2">
              <li><a href="/about" class="hover:text-accent transition">About</a></li>
              <li><a href="/services" class="hover:text-accent transition">Services</a></li>
              <li><a href="/projects" class="hover:text-accent transition">Projects</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold mb-4">Services</h4>
            <ul class="text-gray-300 space-y-2">
              <li><a href="/services#web-design" class="hover:text-accent transition">Web Design</a></li>
              <li><a href="/services#development" class="hover:text-accent transition">Development</a></li>
              <li><a href="/services#seo" class="hover:text-accent transition">SEO</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold mb-4">Contact</h4>
            <p class="text-gray-300">Email: info@emtek.lk</p>
            <p class="text-gray-300">Phone: +94 123 456 789</p>
          </div>
        </div>
        <div class="border-t border-gray-700 pt-8 text-center text-gray-400">
          <p>&copy; 2026 EMTEK. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(html) {
    @apply scroll-smooth;
  }
</style>
