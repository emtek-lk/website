---
import '../styles/global.css';
// Latin-only variable Inter, self-hosted and preloaded (no third-party font request)
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { socialProfiles } from '../data/social';

interface Props {
  /** Page title without the brand suffix. Omit on the home page. */
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a 1200x630 share image */
  image?: string;
  /** Extra JSON-LD objects for this page */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description = site.description, image = '/og-image.png', schema = [], noindex = false } = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ERP, Custom Software & Managed IT Services`;
const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

const fontFace = `@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatin}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: `${site.url}/icon-512.png`,
  slogan: site.tagline,
  knowsAbout: [
    'Enterprise resource planning (ERP)',
    'ERP implementation',
    'Cortex ERP',
    'Microsoft Dynamics 365',
    'Odoo',
    'SAP S/4HANA',
    'Oracle NetSuite',
    'Sage Intacct',
    'Custom software development',
    'Mobile app development',
    'API development',
    'Data migration',
    'AI automation',
    'Cloud migration',
    'Cybersecurity',
    'Managed IT services',
  ],
  description: site.description,
  email: site.email,
  telephone: site.phone,
  sameAs: socialProfiles,
  address: { '@type': 'PostalAddress', addressCountry: site.country },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: site.email,
    telephone: site.phone,
    availableLanguage: ['English'],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFace} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a1f3d" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify([organization, ...schema])} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only z-[60] rounded-full bg-white px-4 py-2 text-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
