---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site, mapsUrl, chat } from '../data/site';
import { services } from '../data/services';
import BrandCoin from '../components/BrandCoin.astro';
import CtaBand from '../components/CtaBand.astro';
import mdi from '@iconify-json/mdi/icons.json';

const waBody = (mdi as unknown as { icons: Record<string, { body: string }> }).icons.whatsapp.body;
const mailSubject = encodeURIComponent('Project enquiry');

const steps = [
  { title: 'Tell us about your challenge', text: 'Email or call us with a short description of what you need and what’s getting in the way today.' },
  { title: 'Discovery conversation', text: 'We learn how your business runs, which systems you use, and what success looks like for you.' },
  { title: 'A clear proposal', text: 'You get a recommended approach, timeline, and scope, covering development, deployment, and ongoing support.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact EMTEK',
    url: `${site.url}/contact`,
    about: { '@id': `${site.url}/#organization` },
  },
];
---

<BaseLayout
  title="Contact EMTEK: ERP, Software & IT Services"
  description={`Talk to EMTEK about ERP, custom software, or managed IT. Email ${site.email}, call ${site.phone}, or visit us in ${site.address.city}, ${site.address.country}.`}
  schema={schema}
>
  <PageHero
    eyebrow="Contact"
    title="Let’s talk about your business"
    lead="Whether you’re planning an ERP rollout, need a custom application, or want dependable IT support, we’d like to hear from you."
  />

  <section class="container-page relative z-10 -mt-16 sm:-mt-24">
    <div class="grid gap-6 md:grid-cols-2">
      <a href={`mailto:${site.email}?subject=${mailSubject}`} class="card group flex items-center gap-6">
        <span class="icon-badge size-14 text-brand-700">
          <Icon name="mail" class="size-6" />
        </span>
        <span>
          <span class="block text-sm text-muted">Email us</span>
          <span class="mt-1 block text-xl font-semibold text-ink group-hover:text-brand-700 sm:text-2xl">{site.email}</span>
        </span>
      </a>
      <a href={site.phoneHref} class="card group flex items-center gap-6">
        <span class="icon-badge size-14 text-brand-700">
          <Icon name="phone" class="size-6" />
        </span>
        <span>
          <span class="block text-sm text-muted">Call us</span>
          <span class="mt-1 block text-xl font-semibold whitespace-nowrap text-ink group-hover:text-brand-700 sm:text-2xl">{site.phone}</span>
        </span>
      </a>
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="card group flex items-center gap-6 md:col-span-2">
        <span class="icon-badge size-14 text-brand-700">
          <Icon name="pin" class="size-6" />
        </span>
        <span class="flex-1">
          <span class="block text-sm text-muted">Visit our office</span>
          <address class="mt-1 block text-xl font-semibold text-ink not-italic group-hover:text-brand-700 sm:text-2xl">
            {site.address.street}, {site.address.city} {site.address.postalCode}, {site.address.country}
          </address>
        </span>
        <span class="hidden items-center gap-1.5 text-sm font-semibold text-brand-700 sm:inline-flex">
          Get directions <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" />
        </span>
      </a>
    </div>
  </section>

  <section class="container-page grid gap-14 py-10 sm:py-28 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="eyebrow">Send a message</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Tell us what you need</h2>
      <p class="mt-4 text-lg">Fill in the form and we’ll reply to the email address you give us, usually within one business day.</p>

      <form id="contact-form" method="post" action="/api/contact" class="mt-10 space-y-5" novalidate>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="cf-name" class="block text-sm font-medium text-ink">Name</label>
            <input id="cf-name" name="name" type="text" required autocomplete="name" maxlength="200" class="input mt-2" aria-describedby="cf-name-error" />
            <p id="cf-name-error" class="field-error" hidden></p>
          </div>
          <div>
            <label for="cf-email" class="block text-sm font-medium text-ink">Email</label>
            <input id="cf-email" name="email" type="email" required autocomplete="email" maxlength="320" class="input mt-2" aria-describedby="cf-email-error" />
            <p id="cf-email-error" class="field-error" hidden></p>
          </div>
        </div>
        <div>
          <label for="cf-phone" class="block text-sm font-medium text-ink">Phone <span class="font-normal text-muted">(optional)</span></label>
          <input id="cf-phone" name="phone" type="tel" autocomplete="tel" maxlength="50" class="input mt-2" />
        </div>
        <div>
          <label for="cf-message" class="block text-sm font-medium text-ink">Message</label>
          <textarea id="cf-message" name="message" required rows="5" maxlength="5000" class="input mt-2" aria-describedby="cf-message-error"></textarea>
          <p id="cf-message-error" class="field-error" hidden></p>
        </div>

        <!-- Honeypot: clipped to zero size (not display:none, which spam bots check for) so it trips only bots -->
        <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
          <label for="cf-website">Leave this field blank</label>
          <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <p id="contact-form-status" class="hidden rounded-xl px-4 py-3 text-sm font-medium" role="status" tabindex="-1"></p>

        <button type="submit" class="btn btn-primary w-full justify-center sm:w-auto">
          Send message <Icon name="arrowRight" class="arrow size-4" />
        </button>
        <p class="text-sm text-muted">By sending this message you agree to our <a href="/privacy" class="font-medium text-brand-700 underline underline-offset-4 hover:text-brand-900">Privacy Policy</a>.</p>
      </form>
    </div>

    <div class="lg:col-span-5">
      <div class="hero-gradient relative isolate flex h-full min-h-[27rem] flex-col justify-end overflow-hidden rounded-3xl p-8 sm:p-10">
        <!-- The coin sits at the centre of an orbit of contact channels (decorative; only the coin takes pointer events) -->
        <div class="pointer-events-none absolute inset-x-0 top-0 bottom-36 grid place-items-center" aria-hidden="true">
          <div class="contact-orbit">
            <span class="contact-orbit-ring"></span>
            {
              (
                [
                  ['mail', -90, 'float-a', '0s'],
                  ['phone', -18, 'float-b', '-1.2s'],
                  ['pin', 54, 'float-a', '-2.4s'],
                  ['chat', 126, 'float-b', '-3.6s'],
                  ['globe', 198, 'float-a', '-4.8s'],
                ] as const
              ).map(([icon, angle, motion, delay]) => (
                <span class="contact-chip" style={`--a:${angle}deg`}>
                  <span class={`${motion} float-chip grid size-11 place-items-center rounded-2xl text-brand-700 sm:size-12`} style={`animation-delay:${delay}`}>
                    <Icon name={icon} class="size-5" />
                  </span>
                </span>
              ))
            }
            <div class="absolute inset-0 grid place-items-center"><BrandCoin size="clamp(5.5rem, 26vw, 7.5rem)" /></div>
          </div>
        </div>
        <div class="relative z-10">
          <p class="text-xl font-semibold text-white">However you reach us, a real engineer replies</p>
          <p class="mt-2 text-white/80">No call centre and no ticket queue, just a direct line to the people building your system.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page grid gap-14 py-10 sm:py-28 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="eyebrow">What happens next</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">From first message to a clear plan</h2>
      <ol class="mt-10 space-y-8">
        {
          steps.map((s, i) => (
            <li class="flex gap-5">
              <span class="grid size-10 shrink-0 place-items-center rounded-full bg-brand-50 font-semibold text-brand-700">{i + 1}</span>
              <div>
                <h3 class="text-lg font-semibold">{s.title}</h3>
                <p class="mt-1">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <aside class="lg:col-span-5">
      <div class="card bg-canvas">
        <h2 class="text-lg font-semibold">Helpful to include</h2>
        <ul class="mt-4 space-y-3">
          {
            [
              'Which service you’re interested in',
              'The systems and tools you use today',
              'The size of your team and number of locations',
              'Your ideal timeline',
            ].map((item) => (
              <li class="flex gap-2">
                <Icon name="check" class="mt-1 size-4 shrink-0 text-brand-500" />
                {item}
              </li>
            ))
          }
        </ul>
        <h2 class="mt-8 text-lg font-semibold">Our services</h2>
        <ul class="mt-4 space-y-2">
          {
            services.map((s) => (
              <li>
                <a href={`/services/${s.slug}`} class="inline-flex items-center gap-2 font-medium text-brand-700 hover:text-brand-900">
                  <Icon name={s.icon} class="size-4" />
                  {s.shortTitle}
                </a>
              </li>
            ))
          }
        </ul>
        <h2 class="mt-8 text-lg font-semibold">Follow us</h2>
        <SocialLinks variant="light" class="mt-4" />
      </div>
    </aside>
  </section>
  <CtaBand
    title="Prefer to talk it through?"
    text="Start a chat or message us on WhatsApp. Our team replies to every message within one business day, and we’ll take it from there."
  >
    <Fragment slot="actions">
      {
        chat.enabled && (
          <button type="button" class="btn btn-light" data-open-chat>
            <Icon name="chat" class="size-4" /> Chat with us
          </button>
        )
      }
      <a href={`https://wa.me/${chat.whatsapp}`} target="_blank" rel="noopener noreferrer" class="btn btn-outline-light">
        <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true" set:html={waBody} /> WhatsApp
      </a>
    </Fragment>
  </CtaBand>
</BaseLayout>

<script>
  // Progressive enhancement for the contact form: without this, it still works as a plain
  // POST to /api/contact, which redirects back here with ?sent=1 or ?error=1.
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#contact-form-status');

  const showStatus = (ok: boolean, message: string) => {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-800', 'bg-red-50', 'text-red-800');
    status.classList.add(ok ? 'bg-emerald-50' : 'bg-red-50', ok ? 'text-emerald-800' : 'text-red-800');
  };

  const params = new URLSearchParams(location.search);
  if (params.has('sent')) showStatus(true, 'Thanks — your message is on its way. We’ll get back to you soon.');
  if (params.has('error')) showStatus(false, 'Something went wrong sending your message. Please try again or email us directly.');
  if (params.has('sent') || params.has('error')) history.replaceState(null, '', location.pathname);

  // Client-side validation mirrors the server rules (functions/api/contact.ts): inline, per field,
  // announced through aria-describedby, with focus moved to the first invalid field.
  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const rules: Record<string, (v: string) => string> = {
    name: (v) => (v ? '' : 'Enter your name.'),
    email: (v) => (EMAIL_PATTERN.test(v) ? '' : 'Enter a valid email address.'),
    message: (v) => (v ? '' : 'Enter a message.'),
  };
  const setFieldError = (field: HTMLInputElement | HTMLTextAreaElement, message: string) => {
    const slot = document.getElementById(`${field.id}-error`);
    if (!slot) return;
    slot.textContent = message;
    slot.hidden = !message;
    if (message) field.setAttribute('aria-invalid', 'true');
    else field.removeAttribute('aria-invalid');
  };
  const validateField = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const rule = rules[field.name];
    const message = rule ? rule(field.value.trim()) : '';
    setFieldError(field, message);
    return !message;
  };
  const fields = [...(form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('#cf-name, #cf-email, #cf-message') ?? [])];
  for (const field of fields) {
    field.addEventListener('blur', () => field.value && validateField(field));
    field.addEventListener('input', () => field.hasAttribute('aria-invalid') && validateField(field));
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const invalid = fields.filter((f) => !validateField(f));
    if (invalid.length) {
      status?.classList.add('hidden');
      invalid[0].focus();
      return;
    }
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const originalLabel = button?.innerHTML;
    if (button) {
      // Hold the button's width so the label change doesn't make the layout jump
      button.style.minWidth = `${button.offsetWidth}px`;
      button.disabled = true;
      button.textContent = 'Sending…';
    }
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
      const data = await res.json().catch(() => ({ ok: false, error: 'Unexpected response.' }));
      if (data.ok) {
        showStatus(true, 'Thanks — your message is on its way. We’ll get back to you soon.');
        form.reset();
        for (const f of fields) setFieldError(f, '');
      } else {
        showStatus(false, data.error ?? 'Something went wrong sending your message. Please try again or email us directly.');
      }
    } catch {
      showStatus(false, 'Something went wrong sending your message. Please check your connection and try again.');
    } finally {
      if (button && originalLabel) {
        button.disabled = false;
        button.innerHTML = originalLabel;
        button.style.minWidth = '';
      }
      status?.focus();
    }
  });
</script>
