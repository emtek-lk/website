---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import mark from '../logos/favicon.png';
import { site } from '../data/site';
import { services } from '../data/services';

const principles = [
  {
    icon: 'target',
    title: 'Software that fits you',
    text: 'We adapt systems to your established workflows instead of forcing your team to work around generic software.',
  },
  {
    icon: 'layers',
    title: 'One accountable partner',
    text: 'ERP, custom applications, and IT infrastructure under one roof, so nothing falls between vendors.',
  },
  {
    icon: 'shield',
    title: 'Secure by default',
    text: 'Strict data access controls, encrypted backups, and tested disaster recovery are part of every engagement.',
  },
  {
    icon: 'lifebuoy',
    title: 'Here after launch',
    text: 'Go-live is the start of the relationship. We monitor, support, and keep improving what we deliver.',
  },
] as const;
---

<BaseLayout
  title="About Us"
  description="EMTEK helps businesses run smarter through custom ERP, tailored software, and reliable IT services, from development through deployment and ongoing support."
>
  <PageHero eyebrow="About EMTEK" title={site.tagline} lead={site.description} />

  <section class="container-page grid items-center gap-14 py-20 sm:py-28 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="eyebrow">Who we are</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Technology should simplify your business, not complicate it</h2>
      <div class="mt-6 space-y-5 text-lg leading-relaxed">
        <p>
          Growing businesses end up juggling disconnected spreadsheets, off-the-shelf tools that don’t quite fit, and IT that only gets attention when something breaks. EMTEK exists to untangle that.
        </p>
        <p>
          We build and implement ERP systems, including our own Cortex ERP, engineer custom applications around the way you work, and manage the infrastructure, security, and support that keep everything running.
        </p>
        <p>
          We don’t hand over a system and walk away. We partner with you from development, through deployment, and into dedicated ongoing support.
        </p>
      </div>
    </div>
    <div class="lg:col-span-5">
      <div class="hero-gradient grid aspect-square place-items-center rounded-3xl">
        <Image src={mark} alt="" width={200} densities={[1, 2]} class="size-40 drop-shadow-2xl sm:size-52" />
      </div>
    </div>
  </section>

  <section class="bg-canvas">
    <div class="container-page py-20 sm:py-28">
      <div class="max-w-2xl">
        <p class="eyebrow">How we work</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">What you can expect from us</h2>
      </div>
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          principles.map((p) => (
            <li class="card">
              <span class="grid size-12 place-items-center rounded-xl bg-brand-50 text-brand-700">
                <Icon name={p.icon} class="size-6" />
              </span>
              <h3 class="mt-6 text-lg font-semibold">{p.title}</h3>
              <p class="mt-2">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container-page py-20 sm:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow">What we do</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Three practices, one team</h2>
    </div>
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        services.map((s) => (
          <a href={`/services/${s.slug}`} class="card group">
            <span class="grid size-12 place-items-center rounded-xl bg-brand-50 text-brand-700 transition group-hover:bg-brand-700 group-hover:text-white">
              <Icon name={s.icon} class="size-6" />
            </span>
            <h3 class="mt-6 text-xl font-semibold">{s.shortTitle}</h3>
            <p class="mt-3">{s.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <CtaBand />
</BaseLayout>
