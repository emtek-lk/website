---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import TechLogo from '../components/TechLogo.astro';
import ModuleIcon from '../components/erp/ModuleIcon.astro';
import ExpertiseGrid from '../components/erp/ExpertiseGrid.astro';
import { erpPlatforms, otherErps } from '../data/erp';
import TeamSection from '../components/TeamSection.astro';
import { getImage } from 'astro:assets';
import { team } from '../data/team';
import mark from '../logos/favicon.png';
import logo from '../logos/logo.png';
import { site } from '../data/site';
import { services } from '../data/services';

const principles = [
  {
    icon: 'target',
    title: 'Software that fits you',
    text: 'We adapt systems to your established workflows instead of forcing your team to work around generic software.',
  },
  {
    icon: 'layers',
    title: 'One accountable partner',
    text: 'ERP, custom applications, and IT infrastructure under one roof, so nothing falls between vendors.',
  },
  {
    icon: 'shield',
    title: 'Secure by default',
    text: 'Strict data access controls, encrypted backups, and tested disaster recovery are part of every engagement.',
  },
  {
    icon: 'lifebuoy',
    title: 'Here after launch',
    text: 'Go-live is the start of the relationship. We monitor, support, and keep improving what we deliver.',
  },
] as const;

const otherErpText = otherErps.join(', ').replace(/, ([^,]*)$/, ', and $1');

// Person markup helps search engines connect the team to the company
const people = await Promise.all(
  team.map(async (m) => {
    const photo = await getImage({ src: m.photo, width: 400, height: 400, format: 'jpg' });
    return {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: m.name,
      jobTitle: m.role,
      description: m.focus,
      image: new URL(photo.src, site.url).href,
      worksFor: { '@id': `${site.url}/#organization` },
      sameAs: [m.linkedin, m.github],
      knowsAbout: m.skills,
    };
  }),
);

const schema = [
  ...people,
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About EMTEK',
    url: `${site.url}/about`,
    about: { '@id': `${site.url}/#organization` },
  },
];
---

<BaseLayout
  title="About Us: ERP, Software & IT Experts"
  description="EMTEK is an ERP, software, and IT services company in Sri Lanka. We build Cortex ERP, implement Dynamics 365 and Odoo, and manage IT infrastructure."
  schema={schema}
>
  <PageHero eyebrow="About EMTEK" title={site.tagline} lead={site.description} />

  <section class="container-page grid items-center gap-14 py-14 sm:py-28 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="eyebrow">Who we are</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Technology should simplify your business, not complicate it</h2>
      <div class="mt-6 space-y-5 text-lg leading-relaxed">
        <p>
          Growing businesses end up juggling disconnected spreadsheets, off-the-shelf tools that don’t quite fit, and IT that only gets attention when something breaks. EMTEK exists to untangle that.
        </p>
        <p>
          We build and implement ERP systems, including our own <a href="/erp/cortex-erp" class="font-semibold text-brand-700 hover:underline">Cortex ERP</a>, <a href="/erp/microsoft-dynamics-365" class="font-semibold text-brand-700 hover:underline">Microsoft Dynamics 365</a>, and <a href="/erp/odoo" class="font-semibold text-brand-700 hover:underline">Odoo</a>. We engineer custom applications around the way you work, and manage the infrastructure, security, and support that keep everything running.
        </p>
        <p>
          We don’t hand over a system and walk away. We partner with you from development, through deployment, and into dedicated ongoing support.
        </p>
      </div>
    </div>
    <div class="lg:col-span-5">
      <div class="hero-gradient aspect-square rounded-3xl [perspective:900px]">
        <div class="coin-flip" data-coin>
          <div class="coin-face coin-front size-40 sm:size-52">
            <Image src={mark} alt="" width={200} densities={[1, 2]} class="size-full object-cover" />
          </div>
          <div class="coin-face coin-back size-40 sm:size-52">
            <Image src={logo} alt="EMTEK" width={400} densities={[1, 2]} class="size-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-canvas">
    <div class="container-page py-14 sm:py-28">
      <div class="max-w-2xl">
        <p class="eyebrow">How we work</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">What you can expect from us</h2>
      </div>
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          principles.map((p) => (
            <li class="card">
              <span class="icon-tile size-12">
                <Icon name={p.icon} class="size-6" />
              </span>
              <h3 class="mt-6 text-lg font-semibold">{p.title}</h3>
              <p class="mt-2">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Services -->
  <section class="container-page py-14 sm:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow">What we do</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Three practices, one accountable team</h2>
      <p class="mt-4 text-lg">
        Most businesses need more than one kind of technology partner. We bring ERP, custom software, and managed IT together, so the systems that run your business are designed, built, and supported by the same people.
      </p>
    </div>
    <div class="snap-lg mt-12 grid gap-6 lg:grid-cols-3">
      {
        services.map((s) => (
          <a href={`/services/${s.slug}`} class="card group flex flex-col">
            <span class="icon-tile size-12 transition group-hover:bg-brand-700 group-hover:text-white">
              <Icon name={s.icon} class="size-6" />
            </span>
            <h3 class="mt-6 text-xl font-semibold">{s.shortTitle}</h3>
            <p class="mt-3">{s.intro}</p>
            <ul class="mt-6 flex-1 space-y-2 border-t border-line pt-6 text-sm">
              {s.offerings.map((o) => (
                <li class="flex gap-2 text-ink">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-500" />
                  {o.title}
                </li>
              ))}
            </ul>
            <span class="btn btn-ghost mt-6 px-0">
              Learn more <Icon name="arrowRight" class="arrow size-4" />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ERP expertise -->
  <section class="relative isolate overflow-hidden bg-gradient-to-b from-canvas to-white">
    <div class="container-page grid gap-14 py-14 sm:py-28 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow">Our specialty</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">ERP is where we go deepest</h2>
        <div class="mt-6 space-y-5 text-lg leading-relaxed">
          <p>
            An ERP sits at the center of a business, touching finance, people, stock, and sales. Getting it right takes more than configuration: it takes engineers who can change the software itself, move data safely, and keep the whole thing running.
          </p>
          <p>
            That is why we build our own ERP, <strong class="text-ink">Cortex</strong>, and implement and customize <strong class="text-ink">Microsoft Dynamics 365</strong> and <strong class="text-ink">Odoo</strong> at the source-code level. We also work with {otherErpText}.
          </p>
        </div>
        <a href="/erp" class="btn btn-primary mt-8">Explore our ERP platforms <Icon name="arrowRight" class="arrow size-4" /></a>
      </div>

      <ul class="grid gap-4 lg:col-span-7">
        {
          erpPlatforms.map((p) => (
            <li style={`--accent:${p.theme.accent}`}>
              <a href={`/erp/${p.slug}`} class="card group flex flex-col gap-5 !p-6 sm:flex-row sm:items-center">
                <span class="well size-20 transition group-hover:scale-105">
                  <TechLogo name={p.logo} class={p.slug === 'odoo' ? 'h-7 w-16' : 'size-12'} />
                </span>
                <span class="flex-1">
                  <span class="block text-lg font-semibold text-ink group-hover:text-[var(--accent)]">{p.name}</span>
                  <span class="mt-1 block text-sm">{p.intro.title}</span>
                  <span class="mt-3 flex flex-wrap gap-1.5">
                    {p.modules
                      .filter((m) => m.glyph !== 'plus')
                      .slice(0, 7)
                      .map((m) => (
                        <span title={m.name}>
                          <ModuleIcon module={m} class="size-7" />
                        </span>
                      ))}
                  </span>
                </span>
                <Icon name="arrowRight" class="hidden size-5 shrink-0 text-muted transition group-hover:translate-x-1 group-hover:text-[var(--accent)] sm:block" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ExpertiseGrid
    eyebrow="Why EMTEK"
    title="What makes us the experts"
    lead="Deep ERP knowledge, real engineering, and the infrastructure skills to keep it all running: one team, accountable end to end."
  />

  <TeamSection />

  <!-- Technologies -->
  <section class="container-page py-14 sm:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow">Technologies we use</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Enterprise-grade tools, chosen for your business</h2>
      <p class="mt-4 text-lg">We pick the right technology for each problem, from ERP frameworks and databases to cloud platforms, security, and AI.</p>
    </div>
    <div class="mt-12 space-y-6">
      {
        services.map((s) => (
          <div class="card">
            <h3 class="flex items-center gap-3 text-lg font-semibold">
              <span class="icon-tile size-9">
                <Icon name={s.icon} class="size-5" />
              </span>
              <a href={`/services/${s.slug}`} class="hover:text-brand-700">
                {s.shortTitle}
              </a>
            </h3>
            <dl class="mt-6 grid gap-6 md:grid-cols-2">
              {s.stack.map((g) => (
                <div>
                  <dt class="text-sm font-semibold text-muted">{g.group}</dt>
                  <dd class="mt-3 flex flex-wrap gap-2">
                    {g.items.map((item) => (
                      <span class="chip">
                        <TechLogo name={item} class="size-5" />
                        {item}
                      </span>
                    ))}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>
  </section>

  <CtaBand />
</BaseLayout>
