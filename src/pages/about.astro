---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About EMTEK - Our Story & Mission">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container mx-auto px-4">
      <h1>About EMTEK</h1>
      <p>Building digital solutions that transform businesses</p>
    </div>
  </section>

  <!-- About Content -->
  <section class="section container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl font-bold mb-6">Our Story</h2>
        <p class="text-gray-600 mb-4">
          EMTEK was founded with a simple mission: to help businesses of all sizes succeed in the digital world.
        </p>
        <p class="text-gray-600 mb-4">
          With years of experience in web development, design, and digital marketing, our team brings expertise and dedication to every project.
        </p>
        <p class="text-gray-600">
          We believe that technology should empower businesses, not complicate them. That's why we focus on creating solutions that are effective, efficient, and easy to use.
        </p>
      </div>
      <div class="bg-gradient-to-br from-accent to-blue-600 h-96 rounded-lg"></div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="section bg-gray-50">
    <div class="container mx-auto px-4">
      <h2 class="section-title">Our Values</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="card">
          <h3 class="text-xl font-bold mb-3">Quality</h3>
          <p class="text-gray-600">We deliver high-quality solutions that exceed expectations</p>
        </div>
        <div class="card">
          <h3 class="text-xl font-bold mb-3">Innovation</h3>
          <p class="text-gray-600">We stay ahead of trends and embrace new technologies</p>
        </div>
        <div class="card">
          <h3 class="text-xl font-bold mb-3">Partnership</h3>
          <p class="text-gray-600">We work closely with our clients as true partners in success</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="section container mx-auto px-4">
    <h2 class="section-title">Our Team</h2>
    <p class="text-center text-gray-600 max-w-2xl mx-auto mb-12">
      Our talented team of designers, developers, and strategists are passionate about creating digital solutions that make a difference.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="text-center">
        <div class="w-32 h-32 bg-gray-300 rounded-full mx-auto mb-4"></div>
        <h3 class="font-bold text-lg mb-2">Team Member</h3>
        <p class="text-gray-600">Role</p>
      </div>
      <div class="text-center">
        <div class="w-32 h-32 bg-gray-300 rounded-full mx-auto mb-4"></div>
        <h3 class="font-bold text-lg mb-2">Team Member</h3>
        <p class="text-gray-600">Role</p>
      </div>
      <div class="text-center">
        <div class="w-32 h-32 bg-gray-300 rounded-full mx-auto mb-4"></div>
        <h3 class="font-bold text-lg mb-2">Team Member</h3>
        <p class="text-gray-600">Role</p>
      </div>
    </div>
  </section>
</Layout>
