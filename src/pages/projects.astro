---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projects - EMTEK Case Studies">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container mx-auto px-4">
      <h1>Our Projects</h1>
      <p>Successful digital solutions we've delivered</p>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="section container mx-auto px-4">
    <h2 class="section-title">Recent Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Project 1 -->
      <div class="card overflow-hidden hover:shadow-xl transition">
        <div class="h-48 bg-gradient-to-br from-accent to-blue-600 mb-4"></div>
        <h3 class="text-xl font-bold mb-2">Project One</h3>
        <p class="text-gray-600 mb-4">
          A modern e-commerce platform built for an online retailer, resulting in a 150% increase in sales.
        </p>
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-3 py-1 bg-accent/10 text-accent rounded-full text-sm">Web Design</span>
          <span class="px-3 py-1 bg-accent/10 text-accent rounded-full text-sm">Development</span>
        </div>
        <a href="/projects/project-one" class="btn btn-primary">View Project</a>
      </div>

      <!-- Project 2 -->
      <div class="card overflow-hidden hover:shadow-xl transition">
        <div class="h-48 bg-gradient-to-br from-blue-500 to-blue-700 mb-4"></div>
        <h3 class="text-xl font-bold mb-2">Project Two</h3>
        <p class="text-gray-600 mb-4">
          A comprehensive business website with integrated blog and lead generation system for a consulting firm.
        </p>
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-3 py-1 bg-accent/10 text-accent rounded-full text-sm">Web Design</span>
          <span class="px-3 py-1 bg-accent/10 text-accent rounded-full text-sm">SEO</span>
        </div>
        <a href="/projects/project-two" class="btn btn-primary">View Project</a>
      </div>

      <!-- Project 3 -->
      <div class="card overflow-hidden hover:shadow-xl transition">
        <div class="h-48 bg-gradient-to-br from-indigo-500 to-indigo-700 mb-4"></div>
        <h3 class="text-xl font-bold mb-2">Project Three</h3>
        <p class="text-gray-600 mb-4">
          A performance-optimized portfolio website for a creative agency, achieving 98 Lighthouse score.
        </p>
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-3 py-1 bg-accent/10 text-accent rounded-full text-sm">Design</span>
          <span class="px-3 py-1 bg-accent/10 text-accent rounded-full text-sm">Development</span>
        </div>
        <a href="/projects/project-three" class="btn btn-primary">View Project</a>
      </div>

      <!-- Project 4 -->
      <div class="card overflow-hidden hover:shadow-xl transition">
        <div class="h-48 bg-gradient-to-br from-purple-500 to-purple-700 mb-4"></div>
        <h3 class="text-xl font-bold mb-2">Project Four</h3>
        <p class="text-gray-600 mb-4">
          A custom web application for inventory management, streamlining operations and reducing costs by 30%.
        </p>
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-3 py-1 bg-accent/10 text-accent rounded-full text-sm">Web App</span>
          <span class="px-3 py-1 bg-accent/10 text-accent rounded-full text-sm">Backend</span>
        </div>
        <a href="/projects/project-four" class="btn btn-primary">View Project</a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-accent text-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready for Your Next Project?</h2>
      <p class="text-lg mb-8 text-blue-100">Let's create something amazing together</p>
      <a href="/contact" class="btn bg-white text-accent hover:bg-gray-100">Start Your Project</a>
    </div>
  </section>
</Layout>
