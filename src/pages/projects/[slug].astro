---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getService } from '../../data/services';
import Flag from '../../components/Flag.astro';
import { countryNames } from '../../data/testimonials';
import { site } from '../../data/site';
import RelatedProjects from '../../components/RelatedProjects.astro';
import TechLogo from '../../components/TechLogo.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const url = `${site.url}/projects/${project.id}`;
const more = (await getCollection('projects', ({ data: d, id }) => !d.draft && id !== project.id)).sort((a, b) => a.data.order - b.data.order);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.summary,
    url,
    mainEntityOfPage: url,
    author: { '@id': `${site.url}/#organization` },
    publisher: { '@id': `${site.url}/#organization` },
    about: [{ '@type': 'Organization', name: data.client }, ...data.technologies.map((t) => ({ '@type': 'Thing', name: t }))],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Projects', item: `${site.url}/projects` },
      { '@type': 'ListItem', position: 3, name: data.title, item: `${site.url}/projects/${project.id}` },
    ],
  },
];
---

<BaseLayout title={data.seoTitle ?? data.title} description={data.summary} schema={schema} ogType="article">
  <PageHero eyebrow={data.industry ? `Case study · ${data.industry}` : 'Case study'} title={data.title} lead={data.summary}>
    {
      data.clientLogo && (
        <div class="mt-8 inline-flex items-center gap-4 rounded-2xl bg-white px-5 py-3 shadow-lg">
          <Image src={data.clientLogo} alt={`${data.client} logo`} width={240} loading="eager" class="h-14 w-auto max-w-48 object-contain" />
          {data.country && (
            <span class="inline-flex items-center gap-2 border-l border-line pl-4 text-sm font-semibold text-ink">
              <Flag code={data.country} class="size-5" />
              {countryNames[data.country as keyof typeof countryNames] ?? data.country.toUpperCase()}
            </span>
          )}
        </div>
      )
    }
  </PageHero>

  <section class="container-page grid gap-12 py-20 sm:py-28 lg:grid-cols-12">
    <article class="lg:col-span-8">
      {data.cover && <Image src={data.cover} alt={data.coverAlt ?? ''} width={960} class="mb-12 w-full rounded-2xl" />}
      <div class="prose-emtek">
        <Content />
      </div>
    </article>

    <aside class="lg:col-span-4">
      <dl class="card space-y-5 lg:sticky lg:top-8">
        <div>
          <dt class="text-sm text-muted">Client</dt>
          <dd class="mt-1 font-semibold text-ink">{data.client}</dd>
        </div>
        {
          data.country && (
            <div>
              <dt class="text-sm text-muted">Country</dt>
              <dd class="mt-1 flex items-center gap-2 font-semibold text-ink">
                <Flag code={data.country} class="size-5" />
                {countryNames[data.country as keyof typeof countryNames] ?? data.country.toUpperCase()}
              </dd>
            </div>
          )
        }
        {
          data.industry && (
            <div>
              <dt class="text-sm text-muted">Industry</dt>
              <dd class="mt-1 font-semibold text-ink">{data.industry}</dd>
            </div>
          )
        }
        {
          data.year && (
            <div>
              <dt class="text-sm text-muted">Year</dt>
              <dd class="mt-1 font-semibold text-ink">{data.year}</dd>
            </div>
          )
        }
        <div>
          <dt class="text-sm text-muted">Services</dt>
          <dd class="mt-2 flex flex-col gap-1.5">
            {
              data.services.map((slug) => (
                <a href={`/services/${slug}`} class="font-semibold text-brand-700 hover:text-brand-900">
                  {getService(slug)?.shortTitle}
                </a>
              ))
            }
          </dd>
        </div>
        {
          data.technologies.length > 0 && (
            <div>
              <dt class="text-sm text-muted">Technology</dt>
              <dd class="mt-2 flex flex-wrap gap-2">
                {data.technologies.map((t) => (
                  <span class="chip"><TechLogo name={t} class="size-5" />{t}</span>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
    </aside>
  </section>

  <RelatedProjects projects={more} eyebrow="More case studies" title="See what else we’ve delivered" class="!pt-0" />

  <CtaBand title="Have a similar challenge?" />
</BaseLayout>
