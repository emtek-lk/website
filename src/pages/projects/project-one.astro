---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Project One - EMTEK Case Study">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container mx-auto px-4">
      <h1>Project One: E-Commerce Platform</h1>
      <p>A modern online store that increased sales by 150%</p>
    </div>
  </section>

  <!-- Project Details -->
  <section class="section container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div class="md:col-span-2">
        <h2 class="text-3xl font-bold mb-6">Project Overview</h2>

        <div class="bg-gray-200 h-96 rounded-lg mb-8"></div>

        <p class="text-gray-600 mb-6">
          Our client, an online retailer, needed a modern e-commerce platform to replace their outdated site. We designed and built a complete solution using cutting-edge technologies.
        </p>

        <h3 class="text-2xl font-bold mb-4">Challenge</h3>
        <p class="text-gray-600 mb-6">
          The old website was slow, difficult to navigate, and not optimized for mobile devices. This resulted in high bounce rates and low conversion rates.
        </p>

        <h3 class="text-2xl font-bold mb-4">Solution</h3>
        <ul class="text-gray-600 space-y-3 mb-6">
          <li class="flex items-start">
            <span class="text-accent mr-3 font-bold">•</span>
            <span>Built a responsive, fast-loading e-commerce platform</span>
          </li>
          <li class="flex items-start">
            <span class="text-accent mr-3 font-bold">•</span>
            <span>Implemented secure payment processing</span>
          </li>
          <li class="flex items-start">
            <span class="text-accent mr-3 font-bold">•</span>
            <span>Optimized for search engines and mobile</span>
          </li>
          <li class="flex items-start">
            <span class="text-accent mr-3 font-bold">•</span>
            <span>Integrated inventory management system</span>
          </li>
        </ul>

        <h3 class="text-2xl font-bold mb-4">Results</h3>
        <div class="grid grid-cols-3 gap-4 mb-6">
          <div class="bg-accent/10 p-6 rounded-lg">
            <div class="text-2xl font-bold text-accent">150%</div>
            <p class="text-gray-600 text-sm">Sales Increase</p>
          </div>
          <div class="bg-accent/10 p-6 rounded-lg">
            <div class="text-2xl font-bold text-accent">65%</div>
            <p class="text-gray-600 text-sm">Bounce Rate Reduction</p>
          </div>
          <div class="bg-accent/10 p-6 rounded-lg">
            <div class="text-2xl font-bold text-accent">3.2s</div>
            <p class="text-gray-600 text-sm">Load Time</p>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div>
        <div class="card sticky top-20">
          <h3 class="text-xl font-bold mb-4">Project Details</h3>
          <dl class="space-y-4">
            <div>
              <dt class="font-semibold text-gray-900">Client Type</dt>
              <dd class="text-gray-600">Online Retailer</dd>
            </div>
            <div>
              <dt class="font-semibold text-gray-900">Services</dt>
              <dd class="text-gray-600">Design, Development, Optimization</dd>
            </div>
            <div>
              <dt class="font-semibold text-gray-900">Technologies</dt>
              <dd class="text-gray-600">React, Node.js, PostgreSQL</dd>
            </div>
            <div>
              <dt class="font-semibold text-gray-900">Timeline</dt>
              <dd class="text-gray-600">3 months</dd>
            </div>
            <div>
              <dt class="font-semibold text-gray-900">Status</dt>
              <dd class="text-green-600 font-semibold">Completed</dd>
            </div>
          </dl>
          <a href="/contact" class="btn btn-primary w-full mt-6">Start Your Project</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
