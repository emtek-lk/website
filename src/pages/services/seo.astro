---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="SEO Services - EMTEK">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container mx-auto px-4">
      <h1>SEO Optimization Services</h1>
      <p>Increase your online visibility and attract more customers</p>
    </div>
  </section>

  <!-- Service Details -->
  <section class="section container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div class="md:col-span-2">
        <h2 class="text-3xl font-bold mb-6">Search Engine Optimization</h2>
        <p class="text-gray-600 mb-6">
          We help your business get found by the right customers. Our data-driven SEO strategies focus on sustainable, long-term growth.
        </p>

        <h3 class="text-2xl font-bold mb-4 mt-8">Our SEO Services</h3>
        <div class="space-y-6">
          <div>
            <h4 class="font-bold text-lg mb-2">On-Page SEO</h4>
            <p class="text-gray-600">Optimize your content, meta tags, headings, and URL structure for search engines.</p>
          </div>
          <div>
            <h4 class="font-bold text-lg mb-2">Technical SEO</h4>
            <p class="text-gray-600">Improve site speed, mobile responsiveness, crawlability, and structured data.</p>
          </div>
          <div>
            <h4 class="font-bold text-lg mb-2">Content Strategy</h4>
            <p class="text-gray-600">Create valuable content that ranks and attracts your target audience.</p>
          </div>
          <div>
            <h4 class="font-bold text-lg mb-2">Link Building</h4>
            <p class="text-gray-600">Build high-quality backlinks to boost your domain authority.</p>
          </div>
          <div>
            <h4 class="font-bold text-lg mb-2">Local SEO</h4>
            <p class="text-gray-600">Get found by customers in your area with Google My Business optimization.</p>
          </div>
        </div>

        <h3 class="text-2xl font-bold mb-4 mt-8">Our Results</h3>
        <div class="grid grid-cols-3 gap-4">
          <div class="text-center">
            <div class="text-3xl font-bold text-accent">300%</div>
            <p class="text-gray-600 text-sm">Average traffic increase</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-accent">1st</div>
            <p class="text-gray-600 text-sm">Page ranking achieved</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-accent">50+</div>
            <p class="text-gray-600 text-sm">Successful campaigns</p>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div>
        <div class="card sticky top-20">
          <h3 class="text-xl font-bold mb-4">SEO Audit</h3>
          <p class="text-gray-600 mb-4">Get a free comprehensive SEO audit of your website</p>
          <ul class="space-y-3 text-gray-600 mb-6">
            <li class="flex items-start">
              <span class="text-accent mr-3">✓</span>
              <span>Technical Analysis</span>
            </li>
            <li class="flex items-start">
              <span class="text-accent mr-3">✓</span>
              <span>Competitor Comparison</span>
            </li>
            <li class="flex items-start">
              <span class="text-accent mr-3">✓</span>
              <span>Keyword Research</span>
            </li>
            <li class="flex items-start">
              <span class="text-accent mr-3">✓</span>
              <span>Improvement Plan</span>
            </li>
          </ul>
          <a href="/contact" class="btn btn-primary w-full">Get Free Audit</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
