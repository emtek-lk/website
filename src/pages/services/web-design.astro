---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Web Design Services - EMTEK">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container mx-auto px-4">
      <h1>Web Design Services</h1>
      <p>Beautiful, responsive websites that engage your audience</p>
    </div>
  </section>

  <!-- Service Details -->
  <section class="section container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div class="md:col-span-2">
        <h2 class="text-3xl font-bold mb-6">What We Offer</h2>
        <p class="text-gray-600 mb-6">
          Our web design services focus on creating beautiful, user-friendly websites that not only look great but also drive results. We combine modern design principles with user experience best practices.
        </p>

        <h3 class="text-2xl font-bold mb-4 mt-8">Our Process</h3>
        <div class="space-y-6">
          <div>
            <h4 class="font-bold text-lg mb-2">1. Discovery & Planning</h4>
            <p class="text-gray-600">We start by understanding your business, goals, and target audience.</p>
          </div>
          <div>
            <h4 class="font-bold text-lg mb-2">2. Wireframing & Mockups</h4>
            <p class="text-gray-600">We create detailed wireframes and design mockups for your approval.</p>
          </div>
          <div>
            <h4 class="font-bold text-lg mb-2">3. Development</h4>
            <p class="text-gray-600">Our developers build your website using modern technologies and best practices.</p>
          </div>
          <div>
            <h4 class="font-bold text-lg mb-2">4. Testing & Launch</h4>
            <p class="text-gray-600">We thoroughly test and optimize before launching your site.</p>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div>
        <div class="card sticky top-20">
          <h3 class="text-xl font-bold mb-4">Quick Facts</h3>
          <ul class="space-y-3 text-gray-600">
            <li class="flex items-start">
              <span class="text-accent mr-3">✓</span>
              <span>Mobile Responsive</span>
            </li>
            <li class="flex items-start">
              <span class="text-accent mr-3">✓</span>
              <span>SEO Optimized</span>
            </li>
            <li class="flex items-start">
              <span class="text-accent mr-3">✓</span>
              <span>Fast Loading</span>
            </li>
            <li class="flex items-start">
              <span class="text-accent mr-3">✓</span>
              <span>User Friendly</span>
            </li>
            <li class="flex items-start">
              <span class="text-accent mr-3">✓</span>
              <span>Modern Design</span>
            </li>
          </ul>
          <a href="/contact" class="btn btn-primary w-full mt-6">Get Started</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
