---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Web Development Services - EMTEK">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container mx-auto px-4">
      <h1>Web Development Services</h1>
      <p>Powerful, scalable solutions built with modern technologies</p>
    </div>
  </section>

  <!-- Service Details -->
  <section class="section container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div class="md:col-span-2">
        <h2 class="text-3xl font-bold mb-6">Cutting-Edge Development</h2>
        <p class="text-gray-600 mb-6">
          We specialize in building fast, secure, and scalable web applications using the latest technologies and best practices.
        </p>

        <h3 class="text-2xl font-bold mb-4 mt-8">Technologies We Use</h3>
        <div class="grid grid-cols-2 gap-6">
          <div>
            <h4 class="font-bold mb-3">Frontend</h4>
            <ul class="text-gray-600 space-y-2">
              <li>• React</li>
              <li>• Vue.js</li>
              <li>• Astro</li>
              <li>• TypeScript</li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold mb-3">Backend</h4>
            <ul class="text-gray-600 space-y-2">
              <li>• Node.js</li>
              <li>• Python</li>
              <li>• PostgreSQL</li>
              <li>• MongoDB</li>
            </ul>
          </div>
        </div>

        <h3 class="text-2xl font-bold mb-4 mt-8">Our Expertise</h3>
        <ul class="text-gray-600 space-y-3">
          <li class="flex items-start">
            <span class="text-accent mr-3 font-bold">•</span>
            <span><strong>Full Stack Development</strong> - From frontend to backend, we build complete solutions</span>
          </li>
          <li class="flex items-start">
            <span class="text-accent mr-3 font-bold">•</span>
            <span><strong>API Development</strong> - Robust APIs for seamless integrations</span>
          </li>
          <li class="flex items-start">
            <span class="text-accent mr-3 font-bold">•</span>
            <span><strong>Database Design</strong> - Efficient databases optimized for performance</span>
          </li>
          <li class="flex items-start">
            <span class="text-accent mr-3 font-bold">•</span>
            <span><strong>Cloud Deployment</strong> - Secure hosting on reliable platforms</span>
          </li>
        </ul>
      </div>

      <!-- Sidebar -->
      <div>
        <div class="card sticky top-20">
          <h3 class="text-xl font-bold mb-4">Why Choose Us</h3>
          <ul class="space-y-3 text-gray-600">
            <li class="flex items-start">
              <span class="text-accent mr-3">✓</span>
              <span>Latest Technologies</span>
            </li>
            <li class="flex items-start">
              <span class="text-accent mr-3">✓</span>
              <span>Clean Code</span>
            </li>
            <li class="flex items-start">
              <span class="text-accent mr-3">✓</span>
              <span>Scalable Solutions</span>
            </li>
            <li class="flex items-start">
              <span class="text-accent mr-3">✓</span>
              <span>Security First</span>
            </li>
            <li class="flex items-start">
              <span class="text-accent mr-3">✓</span>
              <span>24/7 Support</span>
            </li>
          </ul>
          <a href="/contact" class="btn btn-primary w-full mt-6">Start Project</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
