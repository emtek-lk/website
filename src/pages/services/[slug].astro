---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import TechLogo from '../../components/TechLogo.astro';
import { services, type Service } from '../../data/services';
import { site } from '../../data/site';
import { erpPlatforms } from '../../data/erp';
import { getCollection } from 'astro:content';
import FaqList from '../../components/FaqList.astro';
import RelatedProjects from '../../components/RelatedProjects.astro';

export const getStaticPaths = (() => services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);
const url = new URL(`/services/${service.slug}`, Astro.site).href;
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.services.includes(service.slug))).sort((a, b) => a.data.order - b.data.order);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title,
    description: service.summary,
    url,
    provider: { '@id': `${site.url}/#organization` },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: service.shortTitle,
      itemListElement: service.offerings.map((o) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: o.title, description: o.functionality },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: service.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services` },
      { '@type': 'ListItem', position: 3, name: service.shortTitle, item: url },
    ],
  },
];
---

<BaseLayout title={service.seoTitle} description={service.summary} schema={schema}>
  <PageHero eyebrow="Services" title={service.title} lead={service.intro}>
    <nav aria-label="On this page" class="mt-10 flex flex-wrap gap-2">
      {
        service.offerings.map((o) => (
          <a href={`#${o.id}`} class="rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-white ring-1 ring-white/20 transition hover:bg-white/20">
            {o.title}
          </a>
        ))
      }
      <a href="#technology" class="rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-white ring-1 ring-white/20 transition hover:bg-white/20">Technology</a>
    </nav>
  </PageHero>

  <!-- Offerings -->
  <section class="container-page space-y-6 py-20 sm:py-28">
    {
      service.offerings.map((o, i) => (
        <article id={o.id} class="card scroll-mt-8">
          <p class="text-sm font-semibold text-muted">0{i + 1}</p>
          <h2 class="mt-2 text-2xl font-semibold sm:text-3xl">{o.title}</h2>
          <div class="mt-8 grid gap-8 md:grid-cols-2">
            <div>
              <h3 class="flex items-center gap-2 text-sm font-semibold tracking-wide text-brand-700 uppercase">
                <Icon name="target" class="size-4" /> What it does for you
              </h3>
              <p class="mt-3 text-lg leading-relaxed">{o.functionality}</p>
            </div>
            <div class="rounded-xl bg-canvas p-6">
              <h3 class="flex items-center gap-2 text-sm font-semibold tracking-wide text-brand-700 uppercase">
                <Icon name="code" class="size-4" /> How we build it
              </h3>
              <p class="mt-3 leading-relaxed">{o.development}</p>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  {
    service.slug === 'erp-business-solutions' && (
      <section class="container-page pb-20 sm:pb-28">
        <div class="max-w-2xl">
          <p class="eyebrow">ERP platforms</p>
          <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Explore the platforms we deliver</h2>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {erpPlatforms.map((p) => (
            <a href={`/erp/${p.slug}`} class="card group flex flex-col" style={`--accent:${p.theme.accent}`}>
              <span class="grid size-16 place-items-center rounded-2xl bg-canvas ring-1 ring-line transition group-hover:scale-105">
                <TechLogo name={p.logo} class={p.slug === 'odoo' ? 'h-6 w-14' : 'size-10'} />
              </span>
              <h3 class="mt-5 text-lg font-semibold group-hover:text-[var(--accent)]">{p.name}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed">{p.heroLead}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--accent)]">
                Explore {p.shortName} <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" />
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- Technology -->
  <section id="technology" class="scroll-mt-8 bg-canvas">
    <div class="container-page py-20 sm:py-28">
      <div class="max-w-2xl">
        <p class="eyebrow">Technology</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">The stack behind the service</h2>
        <p class="mt-4 text-lg">Proven, enterprise-grade tools, chosen for what fits your business rather than what we happen to prefer.</p>
      </div>
      <dl class="mt-12 grid gap-6 md:grid-cols-2">
        {
          service.stack.map((g) => (
            <div class="card">
              <dt class="font-semibold text-ink">{g.group}</dt>
              <dd class="mt-4 flex flex-wrap gap-2">
                {g.items.map((item) => (
                  <span class="chip"><TechLogo name={item} class="size-5" />{item}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <RelatedProjects projects={projects} title={`${service.shortTitle} in action`} />

  <!-- FAQ -->
  <section class="bg-canvas">
    <div class="container-page grid gap-12 py-20 sm:py-28 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow">FAQ</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Questions about {service.shortTitle}</h2>
        <p class="mt-4 text-lg">Can’t find your answer? <a href="/contact" class="font-semibold text-brand-700 underline underline-offset-4">Ask us directly</a>.</p>
      </div>
      <div class="lg:col-span-8">
        <FaqList faqs={service.faqs} />
      </div>
    </div>
  </section>

  <!-- Other services -->
  <section class="container-page pt-20 sm:pt-28">
    <h2 class="text-2xl font-semibold">Works even better together</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        others.map((s) => (
          <a href={`/services/${s.slug}`} class="card group flex gap-5">
            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-700 transition group-hover:bg-brand-700 group-hover:text-white">
              <Icon name={s.icon} class="size-6" />
            </span>
            <span>
              <span class="block text-lg font-semibold text-ink">{s.shortTitle}</span>
              <span class="mt-2 block">{s.summary}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <CtaBand title={`Talk to us about ${service.shortTitle}`} />
</BaseLayout>
