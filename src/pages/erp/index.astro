---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import TechLogo from '../../components/TechLogo.astro';
import FaqList from '../../components/FaqList.astro';
import ModuleIcon from '../../components/erp/ModuleIcon.astro';
import ProcessSteps from '../../components/erp/ProcessSteps.astro';
import ExpertiseGrid from '../../components/erp/ExpertiseGrid.astro';
import { erpPlatforms, otherErps } from '../../data/erp';
import { site } from '../../data/site';

const chooseIf: Record<string, string[]> = {
  'cortex-erp': [
    'You want an ERP built around your exact workflows',
    'You’d rather avoid big-vendor licensing fees',
    'You want one team that owns the software end to end',
  ],
  'microsoft-dynamics-365': [
    'Your business already runs on Microsoft tools and Azure',
    'You need enterprise-grade finance and supply chain',
    'You want Microsoft’s platform, tailored to your processes',
  ],
  odoo: [
    'You want modular apps you can switch on as you grow',
    'You need CRM, sales, inventory, and accounting working together',
    'You want an open platform, extended in Python',
  ],
};

const faqs = [
  {
    q: 'Which ERP is right for my business?',
    a: 'It depends on your processes, existing systems, and budget. Cortex suits businesses that want software built around their exact workflows, Dynamics 365 suits Microsoft-centric organizations, and Odoo suits businesses that want modular apps. We help you compare them during discovery.',
  },
  {
    q: 'Can you migrate us from our current ERP or spreadsheets?',
    a: 'Yes. We run ETL (Extract, Transform, Load) pipelines to move data from legacy systems and spreadsheets into your new ERP, keeping transaction records accurate.',
  },
  {
    q: 'Do you only work with Cortex, Dynamics 365, and Odoo?',
    a: `No. We also implement and customize ${otherErps.join(', ').replace(/, ([^,]*)$/, ', and $1')}.`,
  },
  {
    q: 'Can you add AI to our ERP?',
    a: 'Yes. We connect ERP data to large language models to automate reporting and analyze invoices, internal data, and supply chain records, without compromising data access controls.',
  },
  {
    q: 'Who looks after the ERP once it is live?',
    a: 'We do. We provide ongoing support and improvements, and our managed IT team can host, secure, back up, and monitor the infrastructure it runs on.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'ERP implementation and customization',
    serviceType: 'ERP implementation',
    url: `${site.url}/erp`,
    provider: { '@id': `${site.url}/#organization` },
    description: 'Implementation, customization, integration, data migration, and support for Cortex ERP, Microsoft Dynamics 365, Odoo, SAP S/4HANA, Oracle NetSuite, and Sage Intacct.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'ERP', item: `${site.url}/erp` },
    ],
  },
];
---

<BaseLayout
  title="ERP Implementation: Cortex, Dynamics 365 & Odoo"
  description="EMTEK implements, customizes, and supports ERP: our own Cortex ERP, Microsoft Dynamics 365, and Odoo, plus SAP S/4HANA, Oracle NetSuite, and Sage Intacct."
  schema={schema}
>
  <PageHero
    eyebrow="ERP"
    title="ERP implementation, customization, and support"
    lead="Whether you choose our own Cortex ERP, Microsoft Dynamics 365, or Odoo, we shape it around the way your business works, connect it to your tools, migrate your data, and support it long after launch."
  />

  <!-- Platform cards -->
  <section class="container-page py-14 sm:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow">Platforms</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Three ERP platforms, one expert team</h2>
    </div>
    <div class="snap-lg mt-12 grid gap-6 lg:grid-cols-3">
      {
        erpPlatforms.map((p) => (
          <a
            href={`/erp/${p.slug}`}
            class="card group flex flex-col overflow-hidden !p-0 hover:-translate-y-1"
            style={`--accent:${p.theme.accent};--accent-soft:${p.theme.accentSoft}`}
          >
            <div class="hero-custom relative flex h-40 items-center justify-center" style={`--hero-bg:${p.theme.heroBg}`}>
              <span class="grid size-24 place-items-center float-panel rounded-3xl transition duration-300 group-hover:scale-105">
                <TechLogo name={p.logo} class={p.slug === 'odoo' ? 'h-9 w-20' : 'size-14'} />
              </span>
            </div>
            <div class="flex flex-1 flex-col p-6 sm:p-8">
              <h3 class="text-xl font-semibold group-hover:text-[var(--accent)]">{p.name}</h3>
              <p class="mt-2 text-sm leading-relaxed">{p.heroLead}</p>
              <div class="mt-6 flex items-center gap-2">
                {p.modules
                  .filter((m) => m.glyph !== 'plus')
                  .slice(0, 6)
                  .map((m) => (
                    <span title={m.name}>
                      <ModuleIcon module={m} class="size-8" />
                    </span>
                  ))}
              </div>
              <p class="mt-6 border-t border-line pt-5 text-sm font-semibold text-ink">Choose {p.shortName} if…</p>
              <ul class="mt-3 flex-1 space-y-2 text-sm">
                {chooseIf[p.slug].map((reason) => (
                  <li class="flex gap-2">
                    <Icon name="check" class="mt-0.5 size-4 shrink-0 text-[var(--accent)]" strokeWidth={2.6} />
                    {reason}
                  </li>
                ))}
              </ul>
              <span class="mt-6 inline-flex items-center gap-1.5 text-[15px] font-semibold text-[var(--accent)]">
                Explore {p.shortName} <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" />
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-2 text-sm text-muted">
      We also implement and customize
      {
        otherErps.map((name) => (
          <span class="chip">
            <TechLogo name={name} class="size-5" />
            {name}
          </span>
        ))
      }
    </div>
  </section>

  <ExpertiseGrid />

  <ProcessSteps />

  <!-- FAQ -->
  <section class="bg-canvas">
    <div class="container-page grid gap-12 py-14 sm:py-28 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow">FAQ</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">ERP questions, answered</h2>
      </div>
      <div class="lg:col-span-8">
        <FaqList faqs={faqs} />
      </div>
    </div>
  </section>

  <CtaBand title="Find the right ERP for your business" />
</BaseLayout>
