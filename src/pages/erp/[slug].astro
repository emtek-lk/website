---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import TechLogo from '../../components/TechLogo.astro';
import FaqList from '../../components/FaqList.astro';
import ModuleIcon from '../../components/erp/ModuleIcon.astro';
import ProcessSteps from '../../components/erp/ProcessSteps.astro';
import ExpertiseGrid from '../../components/erp/ExpertiseGrid.astro';
import { erpPlatforms, otherErps, type ErpPlatform } from '../../data/erp';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';
import RelatedProjects from '../../components/RelatedProjects.astro';

export const getStaticPaths = (() => erpPlatforms.map((platform) => ({ params: { slug: platform.slug }, props: { platform } }))) satisfies GetStaticPaths;

interface Props {
  platform: ErpPlatform;
}

const { platform: p } = Astro.props;
const url = `${site.url}/erp/${p.slug}`;
const others = erpPlatforms.filter((o) => o.slug !== p.slug);
const isCortex = p.slug === 'cortex-erp';
const projects = await getCollection('projects', ({ data }) => !data.draft && data.technologies.includes(p.name));

// Floating module tiles around the logo in the hero
const orbitSpots = [
  'top-[2%] left-[6%]',
  'top-0 left-[60%]',
  'top-[26%] right-[-2%]',
  'top-[62%] right-0',
  'bottom-[-2%] left-[56%]',
  'bottom-[2%] left-[8%]',
  'top-[48%] left-[-6%]',
  'top-[22%] left-[26%]',
];
const heroModules = p.modules.filter((m) => m.glyph !== 'plus').slice(0, 7);

const schema = [
  isCortex
    ? {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Cortex ERP',
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web',
        description: p.seoDescription,
        url,
        publisher: { '@id': `${site.url}/#organization` },
        featureList: p.modules.filter((m) => m.glyph !== 'plus').map((m) => m.name),
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Service',
        name: `${p.name} implementation and customization`,
        serviceType: `${p.name} implementation`,
        description: p.seoDescription,
        url,
        provider: { '@id': `${site.url}/#organization` },
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: `${p.name} services`,
          itemListElement: p.capabilities.map((c) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: `${p.shortName} ${c.title.toLowerCase()}`, description: c.text } })),
        },
      },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: p.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'ERP', item: `${site.url}/erp` },
      { '@type': 'ListItem', position: 3, name: p.name, item: url },
    ],
  },
];
---

<BaseLayout title={p.seoTitle} description={p.seoDescription} schema={schema}>
  <div style={`--accent:${p.theme.accent};--accent-soft:${p.theme.accentSoft};--accent-strong:${p.theme.accentStrong}`}>
    <!-- Hero -->
    <section class="hero-custom hero-slant relative overflow-hidden pt-32 pb-32 sm:pt-40 sm:pb-40" style={`--hero-bg:${p.theme.heroBg}`}>
      <div class="container-page grid items-center gap-14 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <nav aria-label="Breadcrumb" class="text-sm text-white/70">
            <ol class="flex flex-wrap items-center gap-1.5">
              <li><a href="/" class="hover:text-white">Home</a></li>
              <li aria-hidden="true">/</li>
              <li><a href="/erp" class="hover:text-white">ERP</a></li>
              <li aria-hidden="true">/</li>
              <li class="text-white" aria-current="page">{p.shortName}</li>
            </ol>
          </nav>
          <div class="mt-6 inline-flex items-center gap-3 rounded-full bg-white py-1.5 pr-4 pl-2 shadow-lg">
            <TechLogo name={p.logo} class={p.slug === 'odoo' ? 'h-6 w-16' : 'size-7'} />
            <span class="text-sm font-semibold text-[var(--accent-strong)]">{p.eyebrow}</span>
          </div>
          <h1 class="mt-6 text-4xl font-semibold text-white sm:text-5xl lg:text-[3.5rem] lg:leading-[1.08]">{p.heroTitle}</h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85 sm:text-xl">{p.heroLead}</p>
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a href="/contact" class="btn btn-light">Talk to us about {p.shortName} <Icon name="arrowRight" class="arrow size-4" /></a>
            <a href="#modules" class="btn btn-ghost-light">See the modules <Icon name="arrowRight" class="arrow size-4" /></a>
          </div>
        </div>

        <!-- Logo surrounded by floating module icons (decorative) -->
        <div class="relative hidden h-[26rem] lg:col-span-5 lg:block" aria-hidden="true" data-tilt>
          <div class="orbit-ring orbit-ring-inner !size-72 !border-white/25"></div>
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
            <span class="absolute inset-0 -m-6 rounded-[2.5rem] bg-white/20 blur-2xl"></span>
            <div class="float-a relative grid size-40 place-items-center rounded-[2rem] bg-white/90 shadow-[0_40px_80px_-20px_rgba(0,0,0,0.5)] ring-1 ring-white/70 backdrop-blur-xl">
              <TechLogo name={p.logo} class={p.slug === 'odoo' ? 'h-14 w-32' : 'size-24'} />
            </div>
          </div>
          {
            heroModules.map((m, i) => (
              <div class={`absolute ${orbitSpots[i]}`} data-parallax={String(0.04 + (i % 3) * 0.04)}>
                <div class:list={['rounded-2xl bg-white/90 p-2.5 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)] ring-1 ring-white/70 backdrop-blur', i % 2 ? 'float-b' : 'float-a']} style={`animation-delay:${-i * 0.9}s`}>
                  <ModuleIcon module={m} class="size-11" />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Intro + capabilities -->
    <section class="container-page grid gap-14 py-20 sm:py-28 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow !text-[var(--accent)]">{p.name}</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{p.intro.title}</h2>
        <div class="mt-6 space-y-5 text-lg leading-relaxed">
          {p.intro.paragraphs.map((para) => <p>{para}</p>)}
        </div>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
        {
          p.capabilities.map((c) => (
            <li class="card group !p-6">
              <span class="grid size-11 place-items-center rounded-xl bg-[var(--accent-soft)] text-[var(--accent)] transition group-hover:bg-[var(--accent)] group-hover:text-white">
                <Icon name={c.icon} class="size-5" />
              </span>
              <h3 class="mt-4 font-semibold">{c.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed">{c.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Modules -->
    <section id="modules" class="scroll-mt-20 bg-canvas">
      <div class="container-page py-20 sm:py-28">
        <div class="max-w-2xl">
          <p class="eyebrow !text-[var(--accent)]">Modules</p>
          <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{p.modulesTitle}</h2>
          <p class="mt-4 text-lg">{p.modulesLead}</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            p.modules.map((m) => (
              <li class="card group flex flex-col !p-6 hover:-translate-y-1 hover:border-[var(--accent)]/30 hover:shadow-[0_22px_45px_-22px_rgba(10,31,61,0.4)]">
                <span class="transition duration-300 group-hover:scale-110 group-hover:-rotate-3">
                  <ModuleIcon module={m} class="size-12" />
                </span>
                <h3 class="mt-5 font-semibold">{m.name}</h3>
                <p class="mt-1.5 text-sm leading-relaxed">{m.text}</p>
              </li>
            ))
          }
        </ul>

        <div class="mt-12 flex flex-wrap items-center gap-2">
          <span class="mr-1 text-sm font-medium text-ink">Technology we use with {p.shortName}:</span>
          {
            p.builtWith.map((t) => (
              <span class="chip">
                <TechLogo name={t} class="size-5" />
                {t.replace(/^Microsoft /, '').replace(/ API.*$/, '')}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <ProcessSteps title={`How we deliver ${p.shortName}`} />

    <ExpertiseGrid title={`Why businesses choose EMTEK for ${p.shortName}`} />

    <RelatedProjects projects={projects} eyebrow="Case study" title={`${p.shortName} in production`} />

    <!-- FAQ -->
    <section class="container-page grid gap-12 py-20 sm:py-28 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow !text-[var(--accent)]">FAQ</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Questions about {p.shortName}</h2>
        <p class="mt-4 text-lg">Can’t find your answer? <a href="/contact" class="font-semibold text-[var(--accent)] underline underline-offset-4">Ask us directly</a>.</p>
      </div>
      <div class="lg:col-span-8">
        <FaqList faqs={p.faqs} />
      </div>
    </section>

    <!-- Other platforms -->
    <section class="bg-canvas">
      <div class="container-page py-20 sm:py-24">
        <h2 class="text-2xl font-semibold">Other ERP platforms we deliver</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {
            others.map((o) => (
              <a href={`/erp/${o.slug}`} class="card group flex items-center gap-5">
                <span class="grid size-16 shrink-0 place-items-center rounded-2xl bg-canvas ring-1 ring-line">
                  <TechLogo name={o.logo} class={o.slug === 'odoo' ? 'h-6 w-14' : 'size-10'} />
                </span>
                <span class="flex-1">
                  <span class="block text-lg font-semibold text-ink group-hover:text-brand-700">{o.name}</span>
                  <span class="mt-1 line-clamp-2 block text-sm">{o.seoDescription}</span>
                </span>
                <Icon name="arrowRight" class="size-5 shrink-0 text-muted transition group-hover:translate-x-1 group-hover:text-brand-700" />
              </a>
            ))
          }
        </div>
        <p class="mt-8 flex flex-wrap items-center gap-2 text-sm text-muted">
          We also implement and customize
          {
            otherErps.map((name) => (
              <span class="chip">
                <TechLogo name={name} class="size-5" />
                {name}
              </span>
            ))
          }
        </p>
      </div>
    </section>

    <CtaBand title={`Let’s talk about ${p.shortName}`} />
  </div>
</BaseLayout>
