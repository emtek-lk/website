---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import HeroMockup from '../components/HeroMockup.astro';
import ClientStories from '../components/ClientStories.astro';
import ClientMarquee from '../components/ClientMarquee.astro';
import CortexSection from '../components/platforms/CortexSection.astro';
import DynamicsSection from '../components/platforms/DynamicsSection.astro';
import OdooSection from '../components/platforms/OdooSection.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import TechLogo from '../components/TechLogo.astro';
import { featuredTech } from '../data/tech';


const lifecycle = [
  {
    icon: 'code',
    title: 'Development',
    text: 'We map your processes, then build or tailor the ERP, applications, and integrations around how your business actually works.',
  },
  {
    icon: 'rocket',
    title: 'Deployment',
    text: 'We migrate your data, set up secure cloud or on-premise infrastructure, and bring your team on board without disrupting daily operations.',
  },
  {
    icon: 'lifebuoy',
    title: 'Ongoing support',
    text: 'We stay on as your technology partner: monitoring, securing, backing up, and improving your systems, with help desk support for your people.',
  },
] as const;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    name: site.name,
    url: site.url,
    description: site.description,
    publisher: { '@id': `${site.url}/#organization` },
    inLanguage: 'en',
  },
];
---

<BaseLayout
  description="EMTEK builds custom ERP software (Cortex ERP), implements Microsoft Dynamics 365 and Odoo, develops custom apps, and provides managed IT, cloud, and security."
  schema={schema}
>
  <!-- Hero -->
  <section class="hero-gradient hero-slant relative overflow-hidden pt-32 pb-24 sm:pt-44 sm:pb-44">
    <div class="container-page relative grid items-center gap-16 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="enter pill-glass">
          ERP · Custom software · Managed IT
        </p>
        <h1 class="mt-6 text-5xl font-semibold text-white sm:text-6xl lg:text-[4.25rem] lg:leading-[1.05]">
          {site.tagline}
        </h1>
        <p class="enter mt-6 max-w-xl text-lg leading-relaxed text-brand-100/90 sm:text-xl" style="--d:120ms">{site.description}</p>
        <div class="enter mt-10 flex flex-wrap items-center gap-4" style="--d:220ms">
          <a href="/contact" class="btn btn-light">Talk to us <Icon name="arrowRight" class="arrow size-4" /></a>
          <a href="/services" class="btn btn-ghost-light">Explore services <Icon name="arrowRight" class="arrow size-4" /></a>
        </div>
      </div>

      <div class="enter lg:col-span-6" style="--d:300ms"><HeroMockup /></div>
    </div>
  </section>

  <ClientMarquee />

  <!-- Services -->
  <section class="container-page py-14 sm:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow">What we do</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">One partner for the systems that run your business</h2>
      <p class="mt-4 text-lg">
        From the ERP at the center of your operations to the apps your customers use and the infrastructure underneath, we design, build, and look after all of it.
      </p>
    </div>
    <div class="snap-lg mt-14 grid gap-6 lg:grid-cols-3">
      {
        services.map((s) => (
          <a href={`/services/${s.slug}`} class="card group flex flex-col">
            <span class="icon-tile size-12 transition group-hover:bg-brand-700 group-hover:text-white">
              <Icon name={s.icon} class="size-6" />
            </span>
            <h3 class="mt-6 text-xl font-semibold">{s.shortTitle}</h3>
            <p class="mt-3 flex-1">{s.summary}</p>
            <ul class="mt-6 space-y-2 border-t border-line pt-6 text-sm">
              {s.offerings.map((o) => (
                <li class="flex gap-2 text-ink">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-500" />
                  {o.title}
                </li>
              ))}
            </ul>
            <span class="btn btn-ghost mt-6 px-0">
              Learn more <Icon name="arrowRight" class="arrow size-4" />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Platforms we deliver -->
  <CortexSection />
  <DynamicsSection />
  <OdooSection />

  <!-- Lifecycle -->
  <section class="bg-canvas">
    <div class="container-page py-14 sm:py-28">
      <div class="max-w-2xl">
        <p class="eyebrow">How we work</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl" data-words>With you from the first line of code to the thousandth support ticket</h2>
      </div>
      <ol class="snap-md mt-14 grid gap-6 md:grid-cols-3">
        {
          lifecycle.map((step, i) => (
            <li class="card relative">
              <div class="flex items-center justify-between">
                <span class="grid size-12 place-items-center rounded-xl bg-brand-700 text-white">
                  <Icon name={step.icon} class="size-6" />
                </span>
                <span class="text-sm font-semibold text-muted">0{i + 1}</span>
              </div>
              <h3 class="mt-6 text-xl font-semibold">{step.title}</h3>
              <p class="mt-3">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <ClientStories />

  <!-- Technology logo wall -->
  <section class="container-page py-14 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Technology</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">The platforms, languages, and clouds we work with</h2>
    </div>
    <ul class="tech-wall mt-12 grid grid-cols-4 gap-2 sm:gap-3 lg:grid-cols-8">
      {
        featuredTech.map(({ name, label }) => (
          <li class="group flex flex-col items-center gap-3 rounded-2xl border border-transparent px-2 py-5 text-center transition duration-300 hover:border-line hover:bg-canvas">
            <TechLogo name={name} class="size-9" />
            <span class="text-xs font-medium text-body transition group-hover:text-ink">{label ?? name}</span>
          </li>
        ))
      }
    </ul>
  </section>


  <CtaBand />
</BaseLayout>
