---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import HeroMockup from '../components/HeroMockup.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import TechLogo from '../components/TechLogo.astro';
import { featuredTech } from '../data/tech';


const lifecycle = [
  {
    icon: 'code',
    title: 'Development',
    text: 'We map your processes, then build or tailor the ERP, applications, and integrations around how your business actually works.',
  },
  {
    icon: 'rocket',
    title: 'Deployment',
    text: 'We migrate your data, set up secure cloud or on-premise infrastructure, and bring your team on board without disrupting daily operations.',
  },
  {
    icon: 'lifebuoy',
    title: 'Ongoing support',
    text: 'We stay on as your technology partner: monitoring, securing, backing up, and improving your systems, with help desk support for your people.',
  },
] as const;
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero-gradient hero-slant relative overflow-hidden pt-36 pb-32 sm:pt-44 sm:pb-44">
    <div class="container-page relative grid items-center gap-16 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-sm font-medium text-brand-100 ring-1 ring-white/20">
          <Icon name="sparkles" class="size-4" /> ERP · Custom software · Managed IT
        </p>
        <h1 class="mt-6 text-5xl font-semibold text-white sm:text-6xl lg:text-[4.25rem] lg:leading-[1.05]">
          {site.tagline}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-brand-100/90 sm:text-xl">{site.description}</p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="/contact" class="btn btn-light">Talk to us <Icon name="arrowRight" class="arrow size-4" /></a>
          <a href="/services" class="btn btn-ghost-light">Explore services <Icon name="arrowRight" class="arrow size-4" /></a>
        </div>
      </div>

      <div class="hidden lg:col-span-6 lg:block"><HeroMockup /></div>
    </div>
  </section>

  <!-- Technology logo wall -->
  <section class="container-page pt-6 pb-8 sm:pt-10">
    <p class="text-center text-sm font-medium text-muted">The platforms, languages, and clouds we build and run on</p>
    <ul class="tech-wall mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-8">
      {
        featuredTech.map(({ name, label }) => (
          <li class="group flex flex-col items-center gap-3 rounded-2xl border border-transparent px-2 py-5 text-center transition duration-200 hover:border-line hover:bg-canvas">
            <TechLogo name={name} class="size-9" />
            <span class="text-xs font-medium text-body transition group-hover:text-ink">{label ?? name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Services -->
  <section class="container-page py-20 sm:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow">What we do</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">One partner for the systems that run your business</h2>
      <p class="mt-4 text-lg">
        From the ERP at the center of your operations to the apps your customers use and the infrastructure underneath, we design, build, and look after all of it.
      </p>
    </div>
    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      {
        services.map((s) => (
          <a href={`/services/${s.slug}`} class="card group flex flex-col">
            <span class="grid size-12 place-items-center rounded-xl bg-brand-50 text-brand-700 transition group-hover:bg-brand-700 group-hover:text-white">
              <Icon name={s.icon} class="size-6" />
            </span>
            <h3 class="mt-6 text-xl font-semibold">{s.shortTitle}</h3>
            <p class="mt-3 flex-1">{s.summary}</p>
            <ul class="mt-6 space-y-2 border-t border-line pt-6 text-sm">
              {s.offerings.map((o) => (
                <li class="flex gap-2 text-ink">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-500" />
                  {o.title}
                </li>
              ))}
            </ul>
            <span class="btn btn-ghost mt-6 px-0">
              Learn more <Icon name="arrowRight" class="arrow size-4" />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Cortex ERP spotlight -->
  <section class="bg-ink">
    <div class="container-page grid items-center gap-14 py-20 sm:py-28 lg:grid-cols-2">
      <div>
        <div class="flex items-center gap-3">
          <TechLogo name="Cortex ERP" class="size-11" />
          <p class="text-sm font-semibold tracking-wide text-brand-300">Cortex ERP</p>
        </div>
        <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Our own ERP, shaped around your workflows</h2>
        <p class="mt-5 text-lg text-brand-100/75">
          Cortex is EMTEK’s proprietary ERP. It brings finance, HR, inventory, and sales into one dashboard, without the licensing fees of generic enterprise software, and connects to AI to turn your data into answers.
        </p>
        <a href="/services/erp-business-solutions" class="btn btn-light mt-8">
          Explore ERP solutions <Icon name="arrowRight" class="arrow size-4" />
        </a>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          [
            { icon: 'layers', title: 'One unified dashboard', text: 'Finance, HR, inventory, and sales in a single system of record.' },
            { icon: 'target', title: 'Built to fit you', text: 'Custom modules so your team never bends its workflows to fit the software.' },
            { icon: 'plug', title: 'Connected', text: 'API hooks into the tools you use, plus ETL pipelines for legacy data.' },
            { icon: 'sparkles', title: 'AI-ready', text: 'Automated reporting and LLM-powered analysis with strict access controls.' },
          ].map((f) => (
            <li class="rounded-2xl border border-white/10 bg-white/[0.04] p-6">
              <Icon name={f.icon as 'layers'} class="size-6 text-brand-300" />
              <h3 class="mt-4 font-semibold text-white">{f.title}</h3>
              <p class="mt-2 text-sm text-brand-100/70">{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Lifecycle -->
  <section class="bg-canvas">
    <div class="container-page py-20 sm:py-28">
      <div class="max-w-2xl">
        <p class="eyebrow">How we work</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">With you from the first line of code to the thousandth support ticket</h2>
      </div>
      <ol class="mt-14 grid gap-6 md:grid-cols-3">
        {
          lifecycle.map((step, i) => (
            <li class="card relative">
              <div class="flex items-center justify-between">
                <span class="grid size-12 place-items-center rounded-xl bg-brand-700 text-white">
                  <Icon name={step.icon} class="size-6" />
                </span>
                <span class="text-sm font-semibold text-muted">0{i + 1}</span>
              </div>
              <h3 class="mt-6 text-xl font-semibold">{step.title}</h3>
              <p class="mt-3">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
