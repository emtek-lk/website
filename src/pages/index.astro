---
import Layout from '../layouts/Layout.astro';
---

<Layout title="EMTEK - Web Solutions & Digital Services">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl">
        <h1>Transform Your Business Online</h1>
        <p>Professional web solutions designed to help your business grow and reach new customers</p>
        <div class="flex gap-4">
          <a href="/contact" class="btn btn-primary">Get Started</a>
          <a href="/services" class="btn btn-secondary">Our Services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section container mx-auto px-4">
    <h2 class="section-title">Why Choose EMTEK</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="card">
        <div class="text-accent text-3xl mb-4">⚡</div>
        <h3 class="text-xl font-bold mb-3">Lightning Fast</h3>
        <p class="text-gray-600">Optimized performance for the best user experience and SEO rankings</p>
      </div>
      <div class="card">
        <div class="text-accent text-3xl mb-4">🎨</div>
        <h3 class="text-xl font-bold mb-3">Beautiful Design</h3>
        <p class="text-gray-600">Modern, responsive designs that work perfectly on all devices</p>
      </div>
      <div class="card">
        <div class="text-accent text-3xl mb-4">📈</div>
        <h3 class="text-xl font-bold mb-3">Results Driven</h3>
        <p class="text-gray-600">Data-driven solutions that generate leads and drive conversions</p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-accent text-white py-16 mt-20">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Get Started?</h2>
      <p class="text-lg mb-8 text-blue-100">Let's discuss how we can help your business succeed online</p>
      <a href="/contact" class="btn bg-white text-accent hover:bg-gray-100">Contact Us Today</a>
    </div>
  </section>
</Layout>
